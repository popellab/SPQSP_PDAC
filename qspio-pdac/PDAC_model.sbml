    <listOfParameters>
      <parameter id="mwe7d3a09b_446a_4300_af85_03935fb8388f" name="k_cell_clear" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of dead cell clearance from tumour compartment</body>
        </notes>
      </parameter>
      <parameter id="mwf23eace8_cda1_4ed0_bbcb_35db67ea7fbe" name="cell" value="1" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">unit parameter for calculation</body>
        </notes>
      </parameter>
      <parameter id="mwcb967b34_a1a4_4a58_a0ef_3db9fba17dbe" name="day" value="1" units="MWBUILTINUNIT_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">unit parameter for calculation</body>
        </notes>
      </parameter>
      <parameter id="mwdbb7e77d_82d4_46c0_95b6_31f705818187" name="D_cell" value="17" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average diameter of cancer cell</body>
        </notes>
      </parameter>
      <parameter id="mwaeccda0b_0fb2_4f86_9d15_24c4406caa67" name="vol_cell" value="2572.44078451444" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average volume of cancer cell</body>
        </notes>
      </parameter>
      <parameter id="mw7c084833_e8ab_4dd1_8f5c_30647a002f64" name="vol_Tcell" value="175.015709799539" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average volume of T cells</body>
        </notes>
      </parameter>
      <parameter id="mw80f18975_ebf9_4dfc_af08_758261c43691" name="Ve_T" value="0.37" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Intracellular fraction of the tumor</body>
        </notes>
      </parameter>
      <parameter id="mwe440b631_7f88_4226_9e11_b7578f0240b6" name="V_Tmin" value="1e-06" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Minimum tumor compartment volume (cancer-free baseline)</body>
        </notes>
      </parameter>
      <parameter id="mwb3eb2338_3e58_46c1_932a_950f6bec7d11" name="C_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of cancer cells</body>
        </notes>
      </parameter>
      <parameter id="mw0a00bb52_043d_408c_ac67_ec07a02b7a37" name="T_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of activated T cells in tumor</body>
        </notes>
      </parameter>
      <parameter id="mw6a349916_be86_418b_adfe_49ded465676c" name="T_total_LN" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of activated T cells in TDLNs</body>
        </notes>
      </parameter>
      <parameter id="mw61403ba5_8e89_46ab_89fa_8b16b517d1be" name="R_Tcell" value="1" units="MWDERIVEDUNIT_cell__day" constant="false">
