      <parameter id="mw2e066e44_49fa_498b_8179_dcba857112e9" name="k_mAPC_death_ID" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mwd91c6397_c218_47b1_9d53_ec47d3a27187" name="y_Ag_per_cell" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true"/>
      <parameter id="mw9065e9df_cc0c_48a7_a4dd_7f5b9fd45bbc" name="k_P1_deg_ID" value="10" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mwa0b9b190_4888_424f_b0f0_04c188fc740d" name="K_APC_mig" value="100000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mwd4ff42b4_34aa_4fd3_af75_799ee53de64d" name="k_cDC1_Ag_transfer" value="1e-07" units="MWDERIVEDUNIT_1__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen-transfer rate constant: migratory mcDC2 -&gt; resident cDC1 cross-licensing (Ferris 2022 PMID: 35648641; Mueller 2017 Eur J Immunol)</body>
        </notes>
      </parameter>
      <parameter id="mw6c3830f1_74c0_45a0_b851_1930ccf0cee5" name="H_GMCSF_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mw8d141cee_9ec7_4200_88bb_e704a26c3cb4" name="J_mature_ID" value="0" units="MWDERIVEDUNIT_cell__day" constant="false"/>
      <parameter id="mwfcc1fbcd_8c96_482f_8220_f62a360089f1" name="k_Cy_clear" value="2.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide clearance rate</body>
        </notes>
      </parameter>
      <parameter id="mw08e7d963_3804_4bd8_87e0_814c4e6cf5c3" name="k_Cy_Treg_deplete" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Maximum Treg depletion rate by cyclophosphamide</body>
        </notes>
      </parameter>
      <parameter id="mwa7fb4f63_2769_4fd9_b5fa_aa3a8277a459" name="Cy_50_Treg" value="50" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_gram" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide concentration for 50% Treg depletion</body>
        </notes>
      </parameter>
      <parameter id="mw0fc7099b_97da_4b21_97b3_b17726862a5a" name="E_chemo" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Aggregate chemo drug effect on tumor [0,1] (complement-product of per-drug Emax)</body>
        </notes>
      </parameter>
      <parameter id="mwf3eddc75_6876_45a6_a0e6_1cc4aa972ab3" name="k_resist" value="0.0001" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Drug-selected C1-&gt;C2 resistance-acquisition rate per unit E_chemo</body>
        </notes>
      </parameter>
      <parameter id="mw6dfdb045_88fc_4f29_a3bc_28f9914fb0f5" name="k_ca199_sec" value="0.001" units="MWDERIVEDUNIT_picogram__cell__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CA19-9 secretion rate per live cancer cell (patient-level)</body>
        </notes>
      </parameter>
      <parameter id="mw22932c3a_a9fc_4615_b742_ee604039ce76" name="k_ca199_shed" value="0.001" units="MWDERIVEDUNIT_picogram__cell__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CA19-9 shedding rate from the dying/dead cancer-cell pool (V_T.C_x)</body>
        </notes>
      </parameter>
      <parameter id="mwc3c883fa_f70d_4135_8523_7e4ebe1595aa" name="k_ca199_clear" value="0.5" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CA19-9 serum first-order elimination rate</body>
        </notes>
      </parameter>
      <parameter id="mwda3c0000_0003_4000_a000_da39c0000003" name="k_dmg_acc" value="1.0" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Damage accumulation rate per unit E_chemo. FIXED at 1/day and deliberately not sampled: it is exactly degenerate with k_sec_suppress (both scale the suppression), so sampling both would be unidentifiable. k_dmg_rep carries the timescale, k_sec_suppress the strength.</body>
        </notes>
      </parameter>
      <parameter id="mwda3c0000_0004_4000_a000_da39c0000004" name="k_dmg_rep" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Damage repair/reversal rate; sets how long chemo exposure is remembered (0.05/day is a ~14-day half-life). Steady-state damage is k_dmg_acc*mean(E_chemo)/k_dmg_rep, so a slower repair means deeper sustained CA19-9 suppression for the same drug exposure.</body>
        </notes>
      </parameter>
      <parameter id="mw7f50e6ed_5bfc_46ec_a5e2_0c40683d8626" name="k_sec_suppress" value="5" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CA19-9 secretion-suppression strength under aggregate chemo drug effect</body>
        </notes>
      </parameter>
      <parameter id="mw80795b53_ecc5_425e_b95c_7a506f6049dd" name="f_ca199_C2" value="10" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-cell CA19-9 secretion of resistant clone C2 relative to C1</body>
        </notes>
      </parameter>
      <parameter id="mwcf1ce0a0_b7d8_4ff0_8292_ee0a2a19a7c4" name="nucleated_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All nucleated cells in V_T (cancer + immune + CAFs). Used as the denominator for _pct_ calibration targets matching mIHC &quot;% of all nucleated cells&quot; measurements.</body>
        </notes>
      </parameter>
