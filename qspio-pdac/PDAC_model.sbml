      <parameter id="mwd3ea8ff8_870d_4b2e_84bc_b8e8dc8ed4af" name="k_vas_myCAF_sec" value="0.002" units="MWDERIVEDUNIT_picogram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw1d802312_8fea_4dfd_a6f8_fe43140e99f5" name="k_apCAF_iTreg" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective antigen-specific induced-Treg rate via apCAF presentation</body>
        </notes>
      </parameter>
      <parameter id="mw4ba14971_ee00_4ee8_8c0c_9663bc2cda4f" name="P1_50_apCAF" value="1e-09" units="MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent Treg induction by apCAFs</body>
