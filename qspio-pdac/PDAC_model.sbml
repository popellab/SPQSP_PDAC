      <parameter id="mwc08a08d9_8d13_4764_9fc6_a6d7d9966eb2" name="kon_CD47_SIRPa" value="0.0625" units="MWDERIVEDUNIT_1__micromolarity_minute_nanometer" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">kon of CD47-SIRPa binding </body>
        </notes>
      </parameter>
      <parameter id="mw58d97eb3_2321_4217_a91f_7f8beadd97b2" name="koff_CD47_SIRPa" value="0.3" units="MWDERIVEDUNIT_1__minute" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">koff of CD47-SIRPa binding </body>
        </notes>
      </parameter>
      <parameter id="mw3bcebc0b_bae4_4051_a4bb_1cb076ff7645" name="SIRPa_50" value="37" units="MWDERIVEDUNIT_molecule__micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">SIRPa occupancy for half-maximal CD47/SIRPa inhibition on phagocytosis of cancer cells by macrophages </body>
        </notes>
      </parameter>
      <parameter id="mw34a2cd2a_f158_4a1f_8f9c_fcfd5ec2a2ea" name="n_SIRPa" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for CD47/SIRPa inhibition on phagocytosis of cancer cells by macrophages </body>
        </notes>
      </parameter>
      <parameter id="mwe7e3ef25_589e_4398_83cc_eaf498ae70cb" name="H_Mac_C" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for overall checkpoint inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw227264b6_2cb6_4911_9b77_d13f6ec12d66" name="H_PD1_M" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for PD1-mediated inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw437742bf_cbbf_453f_b094_1b07e4c49b93" name="H_SIRPa" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for SIRPa-mediated inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw060d0da4_b458_4bda_bd88_63a9b6aa90a0" name="C_CD47" value="400" units="MWDERIVEDUNIT_molecule__micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CD47 expression on cancer cells </body>
        </notes>
      </parameter>
      <parameter id="mw8640b189_37bf_43c1_96be_735398cfdec7" name="M_PD1_total" value="12500" units="MWBUILTINUNIT_molecule" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">PD-1 expression on macrophages </body>
        </notes>
      </parameter>
      <parameter id="mw8afa3be2_fbd6_40d8_99ba_f05fba67ba1f" name="M_SIRPa" value="100" units="MWDERIVEDUNIT_molecule__micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">SIRPa expression on macrophages </body>
        </notes>
      </parameter>
      <parameter id="mwe0eca4f7_74f2_4fc2_9a9d_7d874cd9bdba" name="A_Mcell" value="1385.4423602331" units="MWDERIVEDUNIT_micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Surface area of the macrophage </body>
        </notes>
      </parameter>
      <parameter id="mwa92202f0_5332_4387_9f45_2fd8d194cb15" name="IL10_50_phago" value="270" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal IL-10 level for phagocytosis by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw00ae6c55_fb41_4aa9_a00e_99bcf4a933f3" name="K_M1_phago" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Association coefficient for macrophage and cancer cell </body>
        </notes>
      </parameter>
      <parameter id="mwceb59dc0_047f_4875_88bd_e6b532890924" name="M_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of macrophages </body>
        </notes>
      </parameter>
      <parameter id="mw52b28d8a_0ab6_481b_9581_7d4eb080f915" name="H_IL10_APC" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill: IL-10 suppression of DC maturation (cDC1/cDC2)</body>
        </notes>
      </parameter>
      <parameter id="mw702109cf_b146_4dc6_a045_38d55b54f44c" name="H_IL10_Treg" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill: IL-10 amplification of Treg-mediated CD8 exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw927f9212_47ca_4ac7_827f_09f7a288d798" name="H_IL10_phago" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL10-mediated inhibition on phagocytosis </body>
        </notes>
      </parameter>
      <parameter id="mwa55328bf_784d_4ddc_a316_8e1993569ae2" name="H_IL12" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL12 </body>
        </notes>
      </parameter>
      <parameter id="mwdbd9885b_18e5_4173_82c8_a8349fab829c" name="H_IL6_M2" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL-6 promotion of M2 macrophage polarization</body>
        </notes>
      </parameter>
      <parameter id="mwf81c2dcd_3314_4a7c_b166_03a62718cb81" name="phi_M2_skew" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Averaged M2-polarizing milieu drive (TGFb/IL-10/IL-6); sets both the fraction of recruited monocytes differentiating directly to M2 and the M1-&gt;M2 polarization drive</body>
        </notes>
      </parameter>
      <parameter id="mw382c8468_eee0_444c_a396_3921e41430b2" name="k_CAF_encounter" value="1000000" units="MWDERIVEDUNIT_cell__milliliter_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of encountering resident PSCs as tumor expands into pancreas</body>
        </notes>
      </parameter>
      <parameter id="mw986b1a93_aed0_4027_a7c0_d964e298f3ad" name="k_CAF_const" value="2000000" units="MWDERIVEDUNIT_cell__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Constitutive PSC density in pancreatic tissue</body>
        </notes>
      </parameter>
      <parameter id="mwbd30d107_8d13_4dc2_bea3_fca6946ac4df" name="k_PSC_to_myCAF" value="0.2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;myCAF activation rate (TGFb-driven)</body>
        </notes>
      </parameter>
      <parameter id="mw8b6100f8_e40a_48a9_9a63_8628975ab9f0" name="k_PSC_to_iCAF" value="0.2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;iCAF activation rate (IL-1-driven)</body>
        </notes>
      </parameter>
      <parameter id="mwf71a4c53_a9c7_443a_8ca5_0301260c7bc6" name="k_PSC_to_apCAF" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;apCAF activation rate (constitutive low)</body>
        </notes>
      </parameter>
      <parameter id="mw5b8b4682_6030_4d4d_9b6f_2cdc07511e45" name="k_iCAF_to_myCAF" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF-&gt;myCAF interconversion (TGFb-driven)</body>
        </notes>
      </parameter>
      <parameter id="mwb94c1b3c_1e7c_4d28_86fa_28d5d64f88d1" name="k_myCAF_to_iCAF" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">myCAF-&gt;iCAF interconversion (IL-1-driven)</body>
        </notes>
      </parameter>
      <parameter id="mw6f8ec5a5_c79e_4755_8b3b_e27e2f236086" name="k_myCAF_prolif" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">myCAF proliferation rate</body>
        </notes>
      </parameter>
      <parameter id="mw9ef9a64e_6ec2_46bd_89c9_6a37405bfbd9" name="k_iCAF_prolif" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF proliferation rate</body>
        </notes>
      </parameter>
      <parameter id="mwe23a7b3a_f832_460b_9ac6_35e158442fea" name="k_apCAF_prolif" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF proliferation rate (lower than iCAF/myCAF)</body>
        </notes>
      </parameter>
      <parameter id="mw030d16f0_2f76_4a89_a75e_1a5de2727cff" name="f_stroma_max" value="2.43" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF:cancer ratio — total carrying-capacity budget partitioned across iCAF/myCAF/apCAF</body>
        </notes>
      </parameter>
      <parameter id="mwa97bc83d_cb7a_4496_8f1d_c6f837cacbb5" name="f_apCAF_of_total" value="0.1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF share of the total CAF carrying capacity. Default 0.1 from Elyada 2019 Fig 5D (apCAFs ~10% of PDAC CAFs). Free parameter in the stick-breaking simplex parameterization (paired with f_iCAF_of_non_apCAF).</body>
        </notes>
      </parameter>
      <parameter id="mwdaea6e14_e073_418a_939a_a3c98c1efbb4" name="f_iCAF_of_non_apCAF" value="0.222" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF share of the non-apCAF CAF mass (stick-breaking second step). Default 0.222 from Elyada 2019 Fig 5D — myCAF 0.7 + iCAF 0.2 of total → iCAF/(iCAF+myCAF) = 0.2/0.9 = 0.222. Free parameter in the stick-breaking simplex parameterization (paired with f_apCAF_of_total).</body>
        </notes>
      </parameter>
      <parameter id="mwac61c81d_e9bd_4854_a34f_885b21a1a1fe" name="k_col_myCAF_sec" value="5e-08" units="MWDERIVEDUNIT_milligram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw3479a5ed_6a90_4935_92db_f5a2e99dc647" name="f_col_basal" value="0.15" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Basal fraction of collagen secretion (TGFb-independent)</body>
        </notes>
      </parameter>
      <parameter id="mwc005af75_00dd_4781_a66d_5204236aca69" name="TGFb_50_CAF_act" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for CAF activation and interconversion</body>
        </notes>
      </parameter>
      <parameter id="mw6bfca5e0_0c69_4b88_80bf_3cfce2900ca2" name="TGFb_50_col_sec" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for collagen secretion</body>
        </notes>
      </parameter>
      <parameter id="mw935682e9_18fc_4f78_af5f_3152701e77be" name="k_col_deg" value="0.007" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Constitutive collagen degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mwcefbf648_e600_480d_b293_f04ce1f58285" name="k_MMP_M2" value="1e-08" units="MWDERIVEDUNIT_milliliter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">M2 macrophage MMP-mediated collagen degradation</body>
        </notes>
      </parameter>
      <parameter id="mw7a04620d_8dc9_46f4_af4b_4e12c6bf0d46" name="phi_cross_50" value="0.03" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction at 50% MMP-susceptibility (LOX-crosslinking shield)</body>
        </notes>
      </parameter>
      <parameter id="mw718b8659_524b_4ea4_a7c5_5a006432245a" name="f_nascent" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Fraction of collagen susceptible to M2 MMP degradation (non-crosslinked)</body>
        </notes>
      </parameter>
      <parameter id="mw13a738e7_f321_460a_a2ab_10c4de8979e0" name="rho_collagen" value="0.103" units="MWDERIVEDUNIT_gram__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen packing density (material constant)</body>
        </notes>
      </parameter>
      <parameter id="mw05dc1748_104d_4b2c_80d6_34ea2099cc14" name="phi_collagen" value="0.12" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction (0-1). Bare-volume normalized; primary input for all ECM Hill functions.</body>
        </notes>
      </parameter>
      <parameter id="mw18ed53cc_0ddb_4713_8ea0_dd1f775946ea" name="k_qpsc_death" value="0.005" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of quiescent PSCs</body>
        </notes>
      </parameter>
      <parameter id="mw97a6fcbe_75a0_46f6_9d13_7239b2404646" name="k_iCAF_death" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwe1f370bc_9911_4f97_880c_a055e11e1743" name="k_myCAF_death" value="0.015" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw5e57fa06_960f_4fb3_9eb0_439a474852f7" name="k_apCAF_death" value="0.03" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwfa35bfb4_67bb_4701_a19a_3c071224df9e" name="d_pore_ref" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference pore size in normal pancreas (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mw2dbe8e46_525c_4f63_b8f9_1b78490ce92c" name="phi_col_ref" value="0.046" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction in normal pancreas (reference)</body>
        </notes>
      </parameter>
      <parameter id="mw3810d295_9277_4b39_b365_b26fe968d08d" name="d_crit_T" value="2.3" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for T cell migration arrest (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mw2d0c633c_c103_455c_8a26_8a31e9d69d78" name="d_crit_APC" value="2.1" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for APC migration arrest (podosome/MMP migration)</body>
        </notes>
      </parameter>
      <parameter id="mwebf5eff9_17d8_48c7_a50c_c1b7571c40d4" name="n_pore" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for pore-size exclusion sharpness</body>
        </notes>
      </parameter>
      <parameter id="mwce8b6400_7bef_4aa9_9bb6_a596f975b917" name="d_pore" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore size between collagen fibers (decreases with density)</body>
        </notes>
      </parameter>
      <parameter id="mw337faf56_27ca_4261_920b_8f3f1723314e" name="H_pore_T" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based T cell exclusion. 1=fully excluded, 0=free migration.</body>
        </notes>
      </parameter>
      <parameter id="mw4702a12e_7b24_4362_a5f9_c7f3c8c01611" name="H_pore_APC" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based APC exclusion. DCs more deformable than T cells.</body>
        </notes>
      </parameter>
      <parameter id="mw35cd8156_dff0_4809_8ace_2df6905a087a" name="E_ref" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference stiffness at phi_col_ref (~1 kPa, dimensionless)</body>
        </notes>
      </parameter>
      <parameter id="mw9a634bb0_f7a3_45ad_a49b_30bc8c9f9f87" name="n_stiff" value="1.8" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Power law exponent for stiffness-collagen relationship</body>
        </notes>
      </parameter>
      <parameter id="mw960119c2_a27d_4e3c_87b1_57502873812a" name="E_50_Texh" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwbd814821_e2a0_4bcb_b1c5_1fcf9f6ead20" name="n_Texh" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwc2232c5d_2da5_4ca6_b2ee_41dad82ff5e7" name="E_50_fib" value="5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for fibroblast mechanotransduction</body>
        </notes>
      </parameter>
      <parameter id="mw665bd9a1_ad92_4134_b603_775c79c31ebf" name="n_fib" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated fibroblast activation</body>
        </notes>
      </parameter>
      <parameter id="mwb3d0a7e1_2934_4e37_b4ff_864652aa4d95" name="stiffness" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tissue stiffness (kPa-scaled, dimensionless). Power law of collagen density.</body>
        </notes>
      </parameter>
      <parameter id="mw0e0b0d11_fd51_4b63_992f_d09ea5fa3891" name="H_stiff_Texh" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated T cell exhaustion (chronic mechanosensing, PD-L1)</body>
        </notes>
      </parameter>
      <parameter id="mw0eb0a073_c726_4cd7_bb46_5b8a5d2eaaf1" name="H_stiff_fib" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated fibroblast activation (YAP/TAZ mechanotransduction)</body>
        </notes>
      </parameter>
      <parameter id="mw6e4c15c2_369b_41df_93c3_ff80ebecd894" name="phi_col_50_Kmax" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">phi_collagen for 50% carrying capacity reduction. &gt;1 = ECM barrier never reaches half-max, consistent with stroma-depletion worsening PDAC (Rhim 2014, Ozdemir 2014).</body>
        </notes>
      </parameter>
      <parameter id="mwa9d3f6b4_efa8_49f6_8f88_2825afc16146" name="phi_col_max" value="0.5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Physical packing ceiling for collagen volume fraction (logistic secretion saturation). ~0.5 = peak fibrillar collagen packing in dense PDAC stroma (placeholder pending primary-source anchor).</body>
        </notes>
      </parameter>
      <parameter id="mw7839db30_2a5d_499e_9141_42337c160464" name="K_stiff_niche" value="100000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF population sustained by stiff ECM alone (mechanotransduction niche via YAP/TAZ). Allows fibrotic scar persistence post-therapy.</body>
        </notes>
      </parameter>
      <parameter id="mw4e59106e_9b74_4e65_b2dd_d9c235365ad0" name="k_stroma_support" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Aggregate stromal contribution scale (global multiplier on subtype-weighted CAF sum in C_max). Constrained by Xu 2010 + Hwang 2008 orthotopic dose-response submodel targets.</body>
        </notes>
      </parameter>
      <parameter id="mw1328b1db_067c_432f_9bb1_156cbc3789c9" name="k_stroma_myCAF" value="1.4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-myCAF contribution to cancer C_max. myCAFs build PDAC desmoplasia (collagen/CXCL12/VEGF) — dominant structural CAF subtype (Elyada 2019; Dominguez 2020).</body>
        </notes>
      </parameter>
      <parameter id="mwd21dd5b2_81f6_4dc4_9417_90ada657324a" name="k_stroma_iCAF" value="0.28" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-iCAF contribution to cancer C_max. iCAFs are inflammatory secretors (IL-6/CXCL12), low αSMA, located distally from tumor — minimal structural carrying-capacity role (Elyada 2019, Öhlund 2017).</body>
        </notes>
      </parameter>
      <parameter id="mwb0128868_e8b7_45ff_9ad3_dd5d958accc5" name="k_stroma_apCAF" value="0.07" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-apCAF contribution to cancer C_max. apCAFs are rare (&lt;5% of CAFs) MHC-II+ tolerogenic antigen-presenters — predominantly immunomodulatory (induce Treg expansion in antigen-specific manner), not structural (Elyada 2019, Huang 2022 Cancer Cell).</body>
        </notes>
      </parameter>
      <parameter id="mw3807b8a5_0b0d_4129_83c5_128cf2a474e5" name="C_cap0" value="1700000000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Baseline C-independent carrying-capacity floor (cells): parenchymal volume the lesion occupies pre-desmoplasia. UN-ANCHORED fitted structural handle (derivedFrom={}); value 1.7e9 is calibrated as the tumor_fold handle coupled with k_C1_growth~0.008, NOT a literature value. Candidate future submodel anchor: accessible parenchymal/lobular volume / vol_cell (queued in reconciliation_targets.csv) -- but GitHub #229 (V_T&lt;-&gt;C_max unification) would DERIVE and dissolve it. Default 0 recovers prior stroma+vascular-only C_max exactly.</body>
        </notes>
      </parameter>
      <parameter id="mwa1a8f9db_5e88_46fb_971a_50b32a25a47f" name="vol_qPSCcell" value="1500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of quiescent PSC</body>
        </notes>
      </parameter>
      <parameter id="mwd3004b23_87a2_4396_9e2b_6810393fd18f" name="vol_iCAFcell" value="2000" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of iCAF</body>
        </notes>
      </parameter>
      <parameter id="mw3affb1f1_ed62_4138_9ee7_89d909e6432a" name="vol_myCAFcell" value="3500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of myCAF</body>
        </notes>
      </parameter>
      <parameter id="mwb9ef09c0_81da_4184_9542_43cac6bbe0f8" name="vol_apCAFcell" value="2500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of apCAF</body>
        </notes>
      </parameter>
      <parameter id="mw53b5ef8c_b1e0_4862_8ce4_72ae8ec187fa" name="k_CXCL12_sec_iCAF" value="1e-10" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 secretion rate by iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwcf7ec988_63e7_4968_84a9_dfa8a4a17d93" name="k_CXCL12_deg" value="2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mwa7c641e9_388a_4281_ad60_06b59526024a" name="CXCL12_50_Texcl" value="8" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for CXCL12-mediated T cell exclusion</body>
        </notes>
      </parameter>
      <parameter id="mw0299fb82_6af0_45a9_89f0_6ca3a418b40a" name="k_IL6_sec_iCAF" value="1.10362194189464e-09" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective iCAF-scaled IL-6 source rate</body>
        </notes>
      </parameter>
      <parameter id="mw788dbc12_9a87_46cd_9c4a_6d196549b309" name="k_IL6_deg" value="16" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mwd3e21090_61c5_4861_b122_f96399a6e8ab" name="IL6_50_MDSC" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 enhancement of MDSC recruitment</body>
        </notes>
      </parameter>
      <parameter id="mwdf0fef2b_be33_4dab_b8ee_7d6a67b48321" name="IL6_50_M2" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 promotion of M2 polarization</body>
        </notes>
      </parameter>
      <parameter id="mw0c720824_2113_452d_8007_ea6abf7ea972" name="IL6_50_iCAF" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 autocrine feedback promoting iCAF phenotype</body>
        </notes>
      </parameter>
      <parameter id="mwbb2f166d_f002_4cb3_b30d_873671708dc7" name="f_IL6_iCAF" value="3" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Fold-enhancement of iCAF formation by IL-6 feedback</body>
        </notes>
      </parameter>
      <parameter id="mw29e66d58_2613_4ad5_953e_499a405628bb" name="H_IL6_iCAF" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL-6 autocrine feedback on iCAF phenotype</body>
        </notes>
      </parameter>
      <parameter id="mw6d9ea6df_0956_4bc0_b8a2_478d0cced76b" name="k_IL1_sec" value="1e-12" units="MWDERIVEDUNIT_nanomole__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-1alpha secretion rate by cancer cells</body>
        </notes>
      </parameter>
      <parameter id="mw73f339d1_4eb2_49b4_8b55_2e7eef6ee952" name="k_IL1_deg" value="6.93" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-1alpha degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mwf025fb2b_ad70_44d6_80e7_bf2d8c434325" name="IL1_50" value="0.01" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Basal EC50 for IL-1-driven iCAF formation</body>
        </notes>
      </parameter>
      <parameter id="mw464c7dd7_7d54_4ea7_9c9c_6aea51921c12" name="n_IL1" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for IL-1-driven iCAF formation</body>
        </notes>
      </parameter>
      <parameter id="mw033a8de9_50ff_4d5a_ac0f_add9a451fde7" name="TGFb_50_IL1R1" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for IL-1R1 downregulation</body>
        </notes>
      </parameter>
      <parameter id="mwa65f10c5_a1f6_4a3a_9b9d_a49b9f7679d9" name="Emax_IL1R1" value="5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max fold-shift of IL-1 EC50 by TGFb-driven IL-1R1 repression</body>
        </notes>
      </parameter>
      <parameter id="mw829ecada_9d99_4f8a_ae85_e2f70b446a64" name="IL1_ratio" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Dimensionless IL-1 ratio: IL1 / effective EC50</body>
        </notes>
      </parameter>
      <parameter id="mwd9032bad_97de_4017_96bd_6ae7d65667be" name="H_IL1_eff" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective IL-1 Hill function. TGFb antagonizes by increasing effective EC50 via IL-1R1 repression (saturating).</body>
        </notes>
      </parameter>
      <parameter id="mw5a46083f_0eb8_46aa_b71c_1db8eff15099" name="k_vas_myCAF_sec" value="0.002" units="MWDERIVEDUNIT_picogram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwc33a2774_60f2_4108_9477_3cb1a777b84f" name="k_apCAF_iTreg" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective antigen-specific induced-Treg rate via apCAF presentation</body>
        </notes>
      </parameter>
      <parameter id="mw59c79573_f28c_45c9_98f3_895bb47222a6" name="P1_50_apCAF" value="1e-09" units="MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent Treg induction by apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwc0c5110b_f04f_49fa_8f7b_4f93966491ce" name="aPSC_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total activated PSC count (iCAF+myCAF+apCAF). Backward compatibility for test statistics.</body>
        </notes>
      </parameter>
      <parameter id="mwc4a0c517_0db9_419e_8ab8_8b120931abda" name="k_TGFb_sec_myCAF" value="2e-10" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGF-β secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw34624d36_c12d_4ae7_bf5d_a4265ccb97d2" name="k_CXCL12_sec_cancer" value="5e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 secretion rate by tumor cells</body>
        </notes>
      </parameter>
      <parameter id="mw2d3b2256_b8b9_44fb_b618_7ed92bacf1cf" name="H_apCAF_pMHCII" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Quasi-steady antigen-presentation gate for apCAF MHC-II-dependent Treg induction</body>
        </notes>
      </parameter>
      <parameter id="mwc9c371b8_6ce4_4f5e_ae55_cd07f758e253" name="k_GVAX_clearance" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GVAX cell clearance rate from tumor</body>
        </notes>
      </parameter>
      <parameter id="mwfde71e1b_fc3d_4b21_919d_53c1a00a8d88" name="V_ID_volume" value="0.0001" units="MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of intradermal injection site (~0.1 mL)</body>
        </notes>
      </parameter>
      <parameter id="mweac24efb_799e_4e22_bd92_addd6654b31c" name="k_GMCSF_prod" value="1e-08" units="MWDERIVEDUNIT_nanomolarity__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF production rate per GVAX cell per day</body>
        </notes>
      </parameter>
      <parameter id="mwd13878ab_652b_4ca7_83be_a0902243d64c" name="k_GMCSF_deg" value="5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF degradation/clearance rate (half-life ~3 hours)</body>
        </notes>
      </parameter>
      <parameter id="mw9a779f2d_cb89_4fdd_84e2_d9352e408901" name="k_APC_recruit_ID" value="100000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC recruitment rate to intradermal injection site</body>
        </notes>
      </parameter>
      <parameter id="mw5f96076c_bb5e_4fb3_80b3_b3e8e2dee840" name="EC50_GMCSF" value="0.00294005042817446" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for GM-CSF-mediated APC recruitment and maturation</body>
        </notes>
      </parameter>
      <parameter id="mwcc1fa391_6560_4127_995e_9df175550616" name="k_APC_mature_ID" value="2.72805986290677" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC maturation rate at injection site</body>
        </notes>
      </parameter>
      <parameter id="mw2fe00f24_010e_4265_b21d_81a0e1e77a98" name="k_APC_mig_ID_LN" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC migration rate from injection site to lymph nodes</body>
        </notes>
      </parameter>
      <parameter id="mwc7436c5f_45a8_4a40_b106_0862936e064e" name="k_APC_death_ID" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC death rate at injection site</body>
        </notes>
      </parameter>
      <parameter id="mw03707624_0b88_4d40_81f5_b19915f8ff2d" name="sigma_P1_per_mAPC" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen consumed per APC maturation event at injection site</body>
        </notes>
      </parameter>
      <parameter id="mw3c124d52_147a_4927_920f_05cdc234273d" name="EC50_P1_mature" value="0.1" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent APC maturation. Lowered from 10 nM to 0.1 nM on 2026-04-21 (Fix 3): with the 10 nM value, V_ID.P1_GVAX (~0.009 nM steady state) produced a Hill factor of ~0.0009 in J_mature_ID, so GVAX-derived antigen was never a meaningful contributor to APC maturation — maturation proceeded almost entirely via the GMCSF + baseline APC terms. 0.1 nM is an estimated value in the nanomolar-affinity range typical of peptide/antigen-receptor interactions; not anchored to a specific primary source. Candidate for submodel-target extraction.</body>
        </notes>
      </parameter>
      <parameter id="mwbe6bb8c6_1e3f_4029_bf46_688bbd21bb35" name="K_APC_ID" value="1000000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mwf9fff04b_9220_43a4_8a52_c12f141bf4bf" name="k_APC_recruit0" value="100" units="MWDERIVEDUNIT_cell__day" constant="true"/>
      <parameter id="mwd6258c57_f668_47ff_b87d_060aa0e8e4fc" name="k_mAPC_death_ID" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mwbd27a0d4_c73c_4267_8116_45d3d91e5b7d" name="y_Ag_per_cell" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true"/>
      <parameter id="mwaddcccef_f81a_4288_89d2_a71897c07351" name="k_P1_deg_ID" value="10" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mw0079d79e_a055_4203_9b24_4a40a7b4ae33" name="K_APC_mig" value="100000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mwf1cfca8a_c023_48bd_9047_5f27190a4f52" name="k_cDC1_Ag_transfer" value="1e-07" units="MWDERIVEDUNIT_1__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen-transfer rate constant: migratory mcDC2 -&gt; resident cDC1 cross-licensing (Ferris 2022 PMID: 35648641; Mueller 2017 Eur J Immunol)</body>
        </notes>
      </parameter>
      <parameter id="mw19e2e407_3ec7_4c3a_85b0_91249d8db900" name="k_GVAX_present" value="14.4" units="MWDERIVEDUNIT_1__day__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Vaccine-antigen presentation-uptake rate into the shared endosomal pMHC pool; parallel to tumor k_up=14.4 (audit consensus #2, GVAX-&gt;H_P1 coupling); placeholder centered at k_up, SBI-varied, submodel anchor pending</body>
        </notes>
      </parameter>
      <parameter id="mwc6b196ae_823d_4673_834a_f771b21a6dbb" name="H_GMCSF_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mw569fe380_1a42_4ba0_bfe9_b6e3173e7f3f" name="HMGB1_50_ID" value="10000000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max death FLUX (cell/day) for HMGB1 (DAMP)-mediated APC maturation at the GVAX injection depot; anchored to the depot operating death flux (~5e7 cell/day peak) so H_HMGB1_ID sits responsive. Literature-anchor route deferred (HMGB1_50_ID = EC50*k_deg*V_ID/q_release).</body>
        </notes>
      </parameter>
      <parameter id="mw5373274e_35e0_485e_961a_6fcb6306844a" name="H_HMGB1_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mw6b0efa64_3546_4d57_a82f_8a2f29085b2b" name="J_mature_ID" value="0" units="MWDERIVEDUNIT_cell__day" constant="false"/>
      <parameter id="mwa5ccd975_f1dc_48a6_9b8e_baac2cf38478" name="f_epitope_spread" value="4.89897948556636" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Shared effective fold-broadening of tumor-specific CD4 and CD8 repertoires under saturating GVAX antigen (qualitatively anchored to Thomas 2004 PMID 15289501; geometric-mean initial value; estimated and requires reduced-model refit).</body>
        </notes>
      </parameter>
      <parameter id="mw6dc74f31_1416_4fce_ba36_b76dc30217de" name="H_P1_spread" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Vaccine-antigen Hill gating epitope-spreading clonal recruitment (Path A); 0 at diagnosis</body>
        </notes>
      </parameter>
      <parameter id="mw16ec9373_a7cd_460c_a966_5a5646a16e8b" name="k_CD8_T_vac_pro" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GVAX-vaccine-gated in-situ tumor CD8 proliferation increment (Path C). Anchored to f*k_CD8_T_pro (f~0.6): the vaccine-differential increment is a bounded fraction of the Blessin-anchored constitutive in-situ rate (k_CD8_T_pro=0.079/day). H_P1_spread-gated (zero without vaccine), saturating in V_T.CD8 density. Retained in gvax_module after the C13 TLA/urelumab cut. Prior sigma 0.7 (was 1.5 placeholder). See notes/calibration/vpop_thexh_cd8vac_anchoring_2026-07-23.md.</body>
        </notes>
      </parameter>
      <parameter id="mwa7f78838_eeb9_4eee_9030_81939f4b198a" name="k_Cy_clear" value="2.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide clearance rate</body>
        </notes>
      </parameter>
      <parameter id="mwad84aa7b_5a02_4535_b8f8_2f042236cb7f" name="k_Cy_Treg_deplete" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Maximum Treg depletion rate by cyclophosphamide</body>
        </notes>
      </parameter>
      <parameter id="mwece407ba_0ef9_4c3d_a254_de98950672a8" name="Cy_50_Treg" value="50" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_gram" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide concentration for 50% Treg depletion</body>
        </notes>
      </parameter>
      <parameter id="mw378f3719_36df_45fb_b035_1e2e3ec6dd6a" name="k_Cy_eff_decay" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Decay rate of the cyclophosphamide durable PD effect compartment (sets Treg-suppression duration)</body>
        </notes>
      </parameter>
      <parameter id="mw58b8be05_5615_49b9_b26a_fb7300cf06b2" name="Emax_Cy_Treg" value="0.8" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Maximum fractional suppression of tumor-Treg proliferation by the Cy effect compartment</body>
        </notes>
      </parameter>
      <parameter id="mw697bfa2e_41a9_433c_a72d_70e0f720ad5a" name="k_Cy_on" value="10" units="MWDERIVEDUNIT_milligram__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Build rate of the cyclophosphamide effect compartment from drug exposure (structural; weakly identifiable, fixed)</body>
        </notes>
      </parameter>
      <parameter id="mw88319c0f_43b1_4ef4_a7ce_d86afeb1f860" name="Cy_eff_50" value="1" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_gram" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-saturation of the Cy effect compartment on tumor-Treg proliferation (structural; weakly identifiable, fixed)</body>
        </notes>
      </parameter>
      <parameter id="mwc9274ad3_2d02_4ecd_a72b_1c7ab0377269" name="k_Tfh_act" value="10" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of naive CD4 activation into Tfh</body>
        </notes>
      </parameter>
      <parameter id="mw2e117272_9bb8_43e0_91fd_7e0539a359e8" name="k_Tfh_diff_tumor" value="0.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of tumor-local Th -&gt; Tfh differentiation (antigen + IL-6 gated)</body>
        </notes>
      </parameter>
      <parameter id="mw26b2555c_c2af_4143_936b_048337671c8f" name="IL6_50_Tfh" value="0.001" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 Hill function gating Th -&gt; Tfh differentiation in tumor</body>
        </notes>
      </parameter>
      <parameter id="mw2496c8b2_2d22_405c_ab58_973b80809bd6" name="H_IL6_Tfh" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 Hill function for tumor-local Th -&gt; Tfh differentiation</body>
        </notes>
      </parameter>
      <parameter id="mw00277d3a_8157_4771_9b7b_d2137d0708dd" name="k_nB_in" value="10000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Marrow output of naive B cells to blood</body>
        </notes>
      </parameter>
      <parameter id="mw85c4015c_82e4_481a_85d7_ec73e6c884c6" name="k_B_act" value="10" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Naive B activation rate in LN (antigen + Tfh help)</body>
        </notes>
      </parameter>
      <parameter id="mw4e1f203a_c8ca_435e_a46c_71ef6c83abc6" name="n_B_clones" value="50" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Number of antigen-specific B cell clones (clonal expansion)</body>
        </notes>
      </parameter>
      <parameter id="mw7c59b9f8_6be3_471e_8cf1_ccdd40475a9e" name="k_B_pro" value="2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Activated B proliferation rate in LN</body>
        </notes>
      </parameter>
      <parameter id="mwc86809ab_47f4_4445_89cb_3d9f16cbb15f" name="k_B_death" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Mature B cell death rate</body>
        </notes>
      </parameter>
      <parameter id="mw997a5be4_8d69_4d88_889c_d30658e9e0a8" name="k_B_to_plasma" value="0.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor-local aB -&gt; plasma differentiation rate (Tfh-helped)</body>
        </notes>
      </parameter>
      <parameter id="mw9eb72333_7a77_4822_9698_7643973f889f" name="k_plasma_death" value="0.033" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Plasma cell death rate</body>
        </notes>
      </parameter>
      <parameter id="mwc8065b74_a5cc_4f5a_b100_efc49fd8ffa3" name="Tfh_50_B" value="100000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal LN Tfh number for B-cell activation help</body>
        </notes>
      </parameter>
      <parameter id="mw2efa0c84_341b_42f8_87f7_9a4c9312d597" name="k_B_act_tumor" value="1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor-local naive B activation rate (antigen-gated)</body>
        </notes>
      </parameter>
      <parameter id="mw14f6cb59_0615_4bbe_a78b_0bd54b27fbb1" name="k_B_pro_tumor" value="1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor-local activated B proliferation rate (saturating form)</body>
        </notes>
      </parameter>
      <parameter id="mwc301688d_f8dc_4acf_9f0a_8f8408ab9486" name="rho_B_max" value="5000000" units="MWDERIVEDUNIT_cell__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max activated B density in tumor (carrying capacity, analogous to rho_Th_max)</body>
        </notes>
      </parameter>
      <parameter id="mw0549ee2b_e22a_424c_a6ee_a741ea0192d5" name="Tfh_50_plasma" value="1000000" units="MWDERIVEDUNIT_cell__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal tumor Tfh for aB -&gt; plasma differentiation help</body>
        </notes>
      </parameter>
      <parameter id="mwfadfe388_0286_40bc_9888_ed9ed3471ed7" name="k_nB_death" value="0.002" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Naive B cell death rate (was k_nTreg_death)</body>
        </notes>
      </parameter>
      <parameter id="mw1619c19d_1a15_44b5_ad97_00b5174dc216" name="q_nB_LN_in" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Naive B cell entry into LN (was q_nCD4_LN_in)</body>
        </notes>
      </parameter>
      <parameter id="mw0455b20b_dd94_4158_8bb8_62669c114c8e" name="q_nB_LN_out" value="2.88" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Naive B cell exit from LN (was q_nCD4_LN_out)</body>
        </notes>
      </parameter>
      <parameter id="mw61538c95_4bdc_4ba8_911d_158132bc4de2" name="q_B_P_in" value="0.25" units="MWDERIVEDUNIT_1__minute" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Mature B cell transport C-&gt;P (was q_Treg_P_in)</body>
        </notes>
      </parameter>
      <parameter id="mwc0a38a35_5a58_4846_881e_b70099615555" name="q_B_P_out" value="24" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Mature B cell transport P-&gt;C (was q_Treg_P_out)</body>
        </notes>
      </parameter>
      <parameter id="mw391881f6_ce1b_490e_88a0_9a5f267703fb" name="q_B_LN_out" value="24" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Mature B cell exit from LN (was q_Treg_LN_out)</body>
        </notes>
      </parameter>
      <parameter id="mw7dab2960_3a36_45ed_91ce_43faba0bec1b" name="q_B_T_in" value="5.8e-05" units="MWDERIVEDUNIT_1__centimeter___3_minute" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">B cell transmigration into tumor (was q_Treg_T_in)</body>
        </notes>
      </parameter>
      <parameter id="mw4e80d2fd_5c74_4087_8c6e_bc05bbf1c142" name="k_Ab_sec" value="1e-05" units="MWDERIVEDUNIT_nanomole__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Plasma cell antibody secretion rate</body>
        </notes>
      </parameter>
      <parameter id="mw16cd26b1_3428_4d04_b21c_d716bfa73d93" name="k_Ab_deg" value="0.033" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antibody degradation/clearance rate in tumor</body>
        </notes>
      </parameter>
      <parameter id="mw76bcf9ac_6356_4151_a9d5_939e6791fa56" name="Ab_50_ADCC" value="0.01" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal antibody for ADCC (macrophage Fc-mediated killing boost)</body>
        </notes>
      </parameter>
      <parameter id="mwec14773e_0a6e_4993_b3f6_d9966dfc4d16" name="ADCC_boost_max" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max fold-increase in M1 phagocytosis from ADCC</body>
        </notes>
      </parameter>
      <parameter id="mw2b36ef22_a6f9_4e26_8c45_2136993f7049" name="Ab_50_DC" value="29.3" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal antibody for DC immune-complex uptake boost</body>
        </notes>
      </parameter>
      <parameter id="mwd1a8c641_6b25_4ee6_9f7f_d3c8112682c8" name="DC_Ab_boost" value="3.95" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max fold-increase in DC antigen uptake from immune complexes</body>
        </notes>
      </parameter>
      <parameter id="mw3cc24eb2_49f7_4041_83e3_d60e26a63598" name="H_Ab" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for antibody-mediated ADCC and immune-complex effects</body>
        </notes>
      </parameter>
      <parameter id="mw859cfedd_aba4_4be4_862a_7c4bb5382ab0" name="H_Ab_DC" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for antibody-mediated DC uptake boost</body>
        </notes>
      </parameter>
      <parameter id="mw3a37fd2e_823d_4779_8910_b39dec29121a" name="k_Breg_on" value="1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Forward B-&gt;Breg switching rate (TGFb+IL10 gated)</body>
        </notes>
      </parameter>
      <parameter id="mw79b3d510_c3e1_469b_97ef_0c2ff25650d1" name="k_Breg_off" value="2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reverse Breg-&gt;B reversion rate</body>
        </notes>
      </parameter>
      <parameter id="mwf6f25927_b28c_49cf_975c_853f4b52f376" name="TGFb_50_Breg" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for Breg switching</body>
        </notes>
      </parameter>
      <parameter id="mwe079de0a_591c_4c57_a569_e2be2bd46c95" name="IL10_50_Breg" value="8" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-10 EC50 for Breg switching</body>
        </notes>
      </parameter>
      <parameter id="mw19d42172_2712_46ac_a56c_df3927d3c523" name="k_IL10_sec_Breg" value="1.5e-12" units="MWDERIVEDUNIT_nanomole__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Breg IL-10 secretion rate (aBreg only)</body>
        </notes>
      </parameter>
      <parameter id="mw1a33d62b_e2b1_401b_b8d3_5157dc68b691" name="H_TGFb_Breg" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb Hill for Breg switching</body>
        </notes>
      </parameter>
      <parameter id="mw77a840b9_837e_44d6_bb8e_4331ec22533e" name="H_IL10_Breg" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-10 Hill for Breg switching</body>
        </notes>
      </parameter>
      <parameter id="mw6cef0612_8eeb_42fa_8fd6_5304422e5692" name="CD8_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total CD8 T cells in V_T (naive + effector + terminal-exhausted + progenitor-exhausted). Aggregate alias for total-CD8 observables.</body>
        </notes>
      </parameter>
      <parameter id="mw66a99268_1f88_466f_bcf3_b63b5e79865a" name="nucleated_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All nucleated cells in V_T (cancer + immune + CAFs). Used as the denominator for _pct_ calibration targets matching mIHC &quot;% of all nucleated cells&quot; measurements.</body>
        </notes>
      </parameter>
      <parameter id="mwfe61fe8d_6077_4d83_8132_2491add9e709" name="CD8_exh_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Exhausted CD8 T cells in V_T (terminal + progenitor-exhausted).</body>
        </notes>
      </parameter>
      <parameter id="mw62227570_ac6b_4ff9_8009_6654611cb020" name="Th_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Conventional CD4 helper T cells in V_T (naive/effector + exhausted), excluding Treg.</body>
        </notes>
      </parameter>
      <parameter id="mwee752b63_f4eb_4890_aaa1_29d0c18e65a5" name="CD4_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All CD4 T cells in V_T (naive + conventional helper + Treg).</body>
        </notes>
      </parameter>
      <parameter id="mw8a2f5b40_967b_4ac5_834b_5ef7e5d4e9ec" name="Tcell_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All T cells in V_T (CD8 + CD4), the model side of a pan-CD3 stain.</body>
        </notes>
      </parameter>
      <parameter id="mwdbcd2b8c_3395_471e_b8c9_085230bd275e" name="Mac_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumour-associated macrophages in V_T (M1-like + M2-like).</body>
        </notes>
      </parameter>
      <parameter id="mw1e1f5c52_d2a0_49ea_8f36_5eaeda3f5074" name="DC_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All dendritic cells in V_T (immature + mature, cDC1 + cDC2).</body>
        </notes>
      </parameter>
      <parameter id="mw52877879_10e6_4de5_86e8_37b903ea06d9" name="mDC_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Mature dendritic cells in V_T (mcDC1 + mcDC2), the DC-LAMP+ subset.</body>
        </notes>
      </parameter>
      <parameter id="mwce10f7e8_5e8c_44b9_a6b6_fccb882c8ab5" name="cDC1_lineage_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">cDC1 lineage in V_T at any maturation state (cDC1 + mcDC1).</body>
        </notes>
      </parameter>
      <parameter id="mw55f84ce6_33cc_418d_9bcd_32b24029c834" name="cDC2_lineage_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">cDC2 lineage in V_T at any maturation state (cDC2 + mcDC2).</body>
        </notes>
      </parameter>
      <parameter id="mw02c79806_58c0_4181_b9f9_9d196abbe468" name="immune_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All leukocytes in V_T (T cells + macrophages + MDSC + DC). Excludes cancer cells and CAFs, unlike nucleated_total_T.</body>
        </notes>
      </parameter>
      <parameter id="mw9f721f57_5dfb_4329_8083_ed07e49f2c15" name="CD8_total_C" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Whole-repertoire CD8 T cells in V_C (per-clone naive pool scaled by div_CD8, plus the expanded antigen-specific clone).</body>
        </notes>
      </parameter>
      <parameter id="mw63d4b28a_807d_43f9_8028_1cc2cf3de240" name="CAF_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Activated cancer-associated fibroblasts in V_T (iCAF + myCAF + apCAF). Excludes quiescent qPSC.</body>
        </notes>
      </parameter>
    </listOfParameters>
