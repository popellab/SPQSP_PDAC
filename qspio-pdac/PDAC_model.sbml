      <parameter id="mw13ccfb31_8227_4aa6_95bc_7776989ff883" name="k_CXCL12_sec_cancer" value="5e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 secretion rate by tumor cells</body>
        </notes>
      </parameter>
      <parameter id="mw9ab29c7e_7ea3_4783_a38c_ba9f26d462f1" name="H_apCAF_pMHCII" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Quasi-steady antigen-presentation gate for apCAF MHC-II-dependent Treg induction</body>
        </notes>
      </parameter>
      <parameter id="mw43b264a5_6822_4b45_8522_5891fa06d0a6" name="k_GVAX_clearance" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GVAX cell clearance rate from tumor</body>
        </notes>
      </parameter>
      <parameter id="mwd4c4fde4_7b34_4ecf_b39d_ef43d4c81c6f" name="V_ID_volume" value="0.0001" units="MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of intradermal injection site (~0.1 mL)</body>
        </notes>
      </parameter>
      <parameter id="mw39c94eab_edb0_4aeb_a971_2d5c61c41563" name="k_GMCSF_prod" value="1e-08" units="MWDERIVEDUNIT_nanomolarity__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF production rate per GVAX cell per day</body>
        </notes>
      </parameter>
      <parameter id="mw522817b0_81d3_4f85_a39b_7c96d909dd42" name="k_GMCSF_deg" value="5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF degradation/clearance rate (half-life ~3 hours)</body>
        </notes>
      </parameter>
      <parameter id="mwcba92c76_223e_4acc_9d38_6ffd18016967" name="k_APC_recruit_ID" value="100000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC recruitment rate to intradermal injection site</body>
        </notes>
