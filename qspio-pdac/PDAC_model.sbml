      <parameter id="mw88a5f909_67bf_42e5_ae32_235c3494983d" name="k_APC_mature_ID" value="2.72805986290677" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC maturation rate at injection site</body>
        </notes>
      </parameter>
      <parameter id="mwbf1e5d9a_0994_4aaf_91eb_1038173d439f" name="k_APC_mig_ID_LN" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC migration rate from injection site to lymph nodes</body>
        </notes>
      </parameter>
      <parameter id="mw03f80675_fcbd_45b2_aa0b_7f5406323712" name="k_APC_death_ID" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC death rate at injection site</body>
        </notes>
      </parameter>
      <parameter id="mwfde1ce1b_53f8_49e1_8293_fb7001352fa1" name="sigma_P1_per_mAPC" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen consumed per APC maturation event at injection site</body>
        </notes>
      </parameter>
      <parameter id="mw2bfd1ba0_0911_49d6_ae7e_4875ff4048f2" name="EC50_P1_mature" value="0.1" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent APC maturation. Lowered from 10 nM to 0.1 nM on 2026-04-21 (Fix 3): with the 10 nM value, V_ID.P1_GVAX (~0.009 nM steady state) produced a Hill factor of ~0.0009 in J_mature_ID, so GVAX-derived antigen was never a meaningful contributor to APC maturation — maturation proceeded almost entirely via the GMCSF + baseline APC terms. 0.1 nM is an estimated value in the nanomolar-affinity range typical of peptide/antigen-receptor interactions; not anchored to a specific primary source. Candidate for submodel-target extraction.</body>
        </notes>
      </parameter>
      <parameter id="mw52aeb1b1_a084_4c4f_9387_29db082fb468" name="K_APC_ID" value="1000000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mw302f3f30_6d6b_4f0a_a044_0904c4c05d76" name="k_APC_recruit0" value="100" units="MWDERIVEDUNIT_cell__day" constant="true"/>
      <parameter id="mw542fe2c2_e6a5_4293_b8da_74dd280e6370" name="k_mAPC_death_ID" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mwcb4dbfb6_ec51_46e5_a14a_9daa88cebecf" name="y_Ag_per_cell" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true"/>
      <parameter id="mwbdd0b8c6_6858_4e3e_b5a0_31d46c2709e8" name="k_P1_deg_ID" value="10" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mw26bdf710_1c6c_41f0_a0f6_40fa81752db9" name="K_APC_mig" value="100000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mw5a37b69d_3d1c_426a_9a56_121212d26de1" name="k_cDC1_Ag_transfer" value="1e-07" units="MWDERIVEDUNIT_1__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen-transfer rate constant: migratory mcDC2 -&gt; resident cDC1 cross-licensing (Ferris 2022 PMID: 35648641; Mueller 2017 Eur J Immunol)</body>
        </notes>
      </parameter>
      <parameter id="mwbb2242a4_6c8d_4b28_ad91_03837ceb9ad2" name="k_GVAX_present" value="14.4" units="MWDERIVEDUNIT_1__day__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Vaccine-antigen presentation-uptake rate into the shared endosomal pMHC pool; parallel to tumor k_up=14.4 (audit consensus #2, GVAX-&gt;H_P1 coupling); placeholder centered at k_up, SBI-varied, submodel anchor pending</body>
        </notes>
      </parameter>
      <parameter id="mw2dfc54d4_cef4_4a62_905e_eb5c226367c8" name="H_GMCSF_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mw907073e7_68d0_4e8f_ae1a_11a3e3ed3120" name="HMGB1_50_ID" value="10000000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max death FLUX (cell/day) for HMGB1 (DAMP)-mediated APC maturation at the GVAX injection depot; anchored to the depot operating death flux (~5e7 cell/day peak) so H_HMGB1_ID sits responsive. Literature-anchor route deferred (HMGB1_50_ID = EC50*k_deg*V_ID/q_release).</body>
        </notes>
      </parameter>
      <parameter id="mwc490650b_b69c_42f1_b499_c699b45eacba" name="H_HMGB1_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mw5a9b2772_4520_4ecd_80fa_5a71b58f9435" name="J_mature_ID" value="0" units="MWDERIVEDUNIT_cell__day" constant="false"/>
      <parameter id="mwa3902c68_452d_4754_8596_5fcb8b2c7d73" name="f_epitope_spread" value="4.89897948556636" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Shared effective fold-broadening of tumor-specific CD4 and CD8 repertoires under saturating GVAX antigen (qualitatively anchored to Thomas 2004 PMID 15289501; geometric-mean initial value; estimated and requires reduced-model refit).</body>
        </notes>
      </parameter>
      <parameter id="mw4dc73b61_4ccb_436d_a389_35614bee30eb" name="H_P1_spread" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Vaccine-antigen Hill gating epitope-spreading clonal recruitment (Path A); 0 at diagnosis</body>
        </notes>
      </parameter>
      <parameter id="mw71d4f1f3_cdfd_4b2a_b68d_caf7ef0c48f1" name="k_CD8_T_vac_pro" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GVAX-vaccine-gated in-situ tumor CD8 proliferation increment (Path C). Anchored to f*k_CD8_T_pro (f~0.6): the vaccine-differential increment is a bounded fraction of the Blessin-anchored constitutive in-situ rate (k_CD8_T_pro=0.079/day). H_P1_spread-gated (zero without vaccine), saturating in V_T.CD8 density. Retained in gvax_module after the C13 TLA/urelumab cut. Prior sigma 0.7 (was 1.5 placeholder). See notes/calibration/vpop_thexh_cd8vac_anchoring_2026-07-23.md.</body>
        </notes>
      </parameter>
      <parameter id="mwecb6ebe8_3a42_4adb_bf3c_d7d2ab0b76db" name="k_Cy_clear" value="2.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide clearance rate</body>
        </notes>
      </parameter>
      <parameter id="mw7c046100_2f31_4553_9ee7_3dfdf6b2a99b" name="k_Cy_Treg_deplete" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Maximum Treg depletion rate by cyclophosphamide</body>
        </notes>
      </parameter>
      <parameter id="mw321d9d96_b9ed_4a5e_af77_06ba6bf4c40b" name="Cy_50_Treg" value="50" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_gram" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide concentration for 50% Treg depletion</body>
        </notes>
      </parameter>
      <parameter id="mw6ffd6627_0e4c_48b9_b8b3_9fbdc988d84d" name="k_Cy_eff_decay" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Decay rate of the cyclophosphamide durable PD effect compartment (sets Treg-suppression duration)</body>
        </notes>
      </parameter>
      <parameter id="mwe9093fd9_23c5_41ef_a330_e253544f7d01" name="Emax_Cy_Treg" value="0.8" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Maximum fractional suppression of tumor-Treg proliferation by the Cy effect compartment</body>
        </notes>
      </parameter>
      <parameter id="mw6e1dcc35_5f44_4abb_99f0_d0ff587542ae" name="k_Cy_on" value="10" units="MWDERIVEDUNIT_milligram__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Build rate of the cyclophosphamide effect compartment from drug exposure (structural; weakly identifiable, fixed)</body>
        </notes>
      </parameter>
      <parameter id="mw6093f060_fe44_49b2_b58e_6c7979f2d2fc" name="Cy_eff_50" value="1" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_gram" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-saturation of the Cy effect compartment on tumor-Treg proliferation (structural; weakly identifiable, fixed)</body>
        </notes>
      </parameter>
      <parameter id="mwd81defdd_c4f9_4d78_bf12_45848edac144" name="k_Tfh_act" value="10" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of naive CD4 activation into Tfh</body>
        </notes>
      </parameter>
      <parameter id="mw6ad88d57_06a7_4be0_ac21_f11a68a1d3e8" name="k_Tfh_diff_tumor" value="0.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of tumor-local Th -&gt; Tfh differentiation (antigen + IL-6 gated)</body>
        </notes>
      </parameter>
      <parameter id="mw11a6df2e_2207_4cee_9cfc_e84d5ee977b4" name="IL6_50_Tfh" value="0.001" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 Hill function gating Th -&gt; Tfh differentiation in tumor</body>
        </notes>
      </parameter>
      <parameter id="mw52831689_6fe3_4d85_9aa6_b5296a1296d3" name="H_IL6_Tfh" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 Hill function for tumor-local Th -&gt; Tfh differentiation</body>
        </notes>
      </parameter>
      <parameter id="mwa3750024_ffe3_402e_9fa3_2bc10969d76a" name="k_nB_in" value="5000000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Marrow output of naive B cells to blood</body>
        </notes>
      </parameter>
      <parameter id="mw3687f233_c20e_4ea8_8cd4_3a91306eff8c" name="k_B_act" value="10" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Naive B activation rate in LN (antigen + Tfh help)</body>
        </notes>
      </parameter>
      <parameter id="mw17231bd5_7558_4ea5_9368_3e379a6b1a0f" name="n_B_clones" value="50" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Number of antigen-specific B cell clones (clonal expansion)</body>
        </notes>
      </parameter>
      <parameter id="mw73e47324_1451_4ef7_818c_07c5eacc6b6e" name="k_B_pro" value="2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Activated B proliferation rate in LN</body>
        </notes>
      </parameter>
      <parameter id="mw4c700ce0_b2df_4d4a_95fd_4691b8f80da3" name="k_B_death" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Mature B cell death rate</body>
        </notes>
      </parameter>
      <parameter id="mwd51f05be_afcf_4010_8f07_55c2000dea4b" name="k_B_to_plasma" value="0.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor-local aB -&gt; plasma differentiation rate (Tfh-helped)</body>
        </notes>
      </parameter>
      <parameter id="mwdf4913e9_8f1b_45c2_b49a_148f1bb24062" name="k_plasma_death" value="0.033" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Plasma cell death rate</body>
        </notes>
      </parameter>
      <parameter id="mw2f4bb159_44cf_45f7_8c24_9838a43f1c2f" name="Tfh_50_B" value="100000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal LN Tfh number for B-cell activation help</body>
        </notes>
      </parameter>
      <parameter id="mwcebb0faf_94ce_49b9_812c_d4b8770c1802" name="k_B_act_tumor" value="1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor-local naive B activation rate (antigen-gated)</body>
        </notes>
      </parameter>
      <parameter id="mw9865bc1a_a7ae_4b8a_8b15_388954accc9a" name="k_B_pro_tumor" value="1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor-local activated B proliferation rate (saturating form)</body>
        </notes>
      </parameter>
      <parameter id="mwbb254be9_2817_4936_8d77_486d588e3bc7" name="rho_B_max" value="5000000" units="MWDERIVEDUNIT_cell__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max activated B density in tumor (carrying capacity, analogous to rho_Th_max)</body>
        </notes>
      </parameter>
      <parameter id="mw84cc2b44_3fc5_4879_866f_be9b0b911a66" name="Tfh_50_plasma" value="100" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal tumor Tfh for aB -&gt; plasma differentiation help</body>
        </notes>
      </parameter>
      <parameter id="mw9302e714_db35_4f44_8f06_6b62b67de59d" name="k_nB_death" value="0.002" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Naive B cell death rate (was k_nTreg_death)</body>
        </notes>
      </parameter>
      <parameter id="mw9bc96cc8_bd6a_46df_9153_319c1ff3a403" name="q_nB_LN_in" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Naive B cell entry into LN (was q_nCD4_LN_in)</body>
        </notes>
      </parameter>
      <parameter id="mw5fa311ef_c4db_4722_88ac_1787ff97b84a" name="q_nB_LN_out" value="2.88" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Naive B cell exit from LN (was q_nCD4_LN_out)</body>
        </notes>
      </parameter>
      <parameter id="mw1ca66fcf_cc00_4cae_9185_15b7ce799cb2" name="q_B_P_in" value="0.25" units="MWDERIVEDUNIT_1__minute" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Mature B cell transport C-&gt;P (was q_Treg_P_in)</body>
        </notes>
      </parameter>
      <parameter id="mw17c660fb_52a4_49f2_b709_3651d587ddd3" name="q_B_P_out" value="24" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Mature B cell transport P-&gt;C (was q_Treg_P_out)</body>
        </notes>
      </parameter>
      <parameter id="mw77072054_49c9_4a05_bb59_d736fc9363f9" name="q_B_LN_out" value="24" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Mature B cell exit from LN (was q_Treg_LN_out)</body>
        </notes>
      </parameter>
      <parameter id="mwa3f978c1_f9ca_4abd_8732_ceee02cd9d4a" name="q_B_T_in" value="5.8e-05" units="MWDERIVEDUNIT_1__centimeter___3_minute" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">B cell transmigration into tumor (was q_Treg_T_in)</body>
        </notes>
      </parameter>
      <parameter id="mw636e9970_e69e_48e7_a607_fab8ead311d3" name="k_Ab_sec" value="1e-05" units="MWDERIVEDUNIT_nanomole__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Plasma cell antibody secretion rate</body>
        </notes>
      </parameter>
      <parameter id="mw7578b600_eb59_4450_ad52_8a639098810f" name="k_Ab_deg" value="0.033" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antibody degradation/clearance rate in tumor</body>
        </notes>
      </parameter>
      <parameter id="mw04d2ba52_1131_4309_a3e9_00333010c5ed" name="Ab_50_ADCC" value="0.01" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal antibody for ADCC (macrophage Fc-mediated killing boost)</body>
        </notes>
      </parameter>
      <parameter id="mwdb95acf3_b6af_45f4_9ec2_27604e861f70" name="ADCC_boost_max" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max fold-increase in M1 phagocytosis from ADCC</body>
        </notes>
      </parameter>
      <parameter id="mw48aa5787_b715_4d94_8f7c_024c7abcd978" name="Ab_50_DC" value="29.3" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal antibody for DC immune-complex uptake boost</body>
        </notes>
      </parameter>
      <parameter id="mwb13d641d_946a_4b47_ad88_f78504e9ddeb" name="DC_Ab_boost" value="3.95" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max fold-increase in DC antigen uptake from immune complexes</body>
        </notes>
      </parameter>
      <parameter id="mw2b76aa05_8c81_438f_b6ef_79c6483f9a18" name="H_Ab" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for antibody-mediated ADCC and immune-complex effects</body>
        </notes>
      </parameter>
      <parameter id="mw2a4ca439_7006_4831_9a25_1edc0d977b1c" name="H_Ab_DC" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for antibody-mediated DC uptake boost</body>
        </notes>
      </parameter>
      <parameter id="mw782b316f_dfed_4fcc_b4f2_53d6d26f3d56" name="CD8_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total CD8 T cells in V_T (naive + effector + terminal-exhausted + progenitor-exhausted). Aggregate alias for total-CD8 observables.</body>
        </notes>
      </parameter>
      <parameter id="mwef967874_e4e3_420f_9af2_bd8feec470ff" name="nucleated_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All nucleated cells in V_T (cancer + immune + CAFs). Used as the denominator for _pct_ calibration targets matching mIHC &quot;% of all nucleated cells&quot; measurements.</body>
        </notes>
      </parameter>
      <parameter id="mw4e2c14d5_e811_41bc_87a9_e3e93aac90f4" name="CD8_exh_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Exhausted CD8 T cells in V_T (terminal + progenitor-exhausted).</body>
        </notes>
      </parameter>
      <parameter id="mwef982ff6_2d3b_46ac_971a_75d1751af793" name="Th_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Conventional CD4 helper T cells in V_T (naive/effector + exhausted), excluding Treg.</body>
        </notes>
      </parameter>
      <parameter id="mwb586c7fb_e6b2_448c_b346_19b13ce4d27a" name="CD4_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All CD4 T cells in V_T (naive + conventional helper + Treg).</body>
        </notes>
      </parameter>
      <parameter id="mw911328bf_67e2_4182_a93c_5d8425a35bcf" name="Tcell_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All T cells in V_T (CD8 + CD4), the model side of a pan-CD3 stain.</body>
        </notes>
      </parameter>
      <parameter id="mw01b9d949_ee72_49ca_a70b_8c9107cc0a5c" name="Mac_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumour-associated macrophages in V_T (M1-like + M2-like).</body>
        </notes>
      </parameter>
      <parameter id="mw00fca732_f726_48c6_8ca5_f67c41ac51ef" name="DC_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All dendritic cells in V_T (immature + mature, cDC1 + cDC2).</body>
        </notes>
      </parameter>
      <parameter id="mw7792fabb_686f_4274_aebb_28643536290a" name="mDC_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Mature dendritic cells in V_T (mcDC1 + mcDC2), the DC-LAMP+ subset.</body>
        </notes>
      </parameter>
      <parameter id="mwb42d8912_1f52_476f_accb_f8b7202339c3" name="cDC1_lineage_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">cDC1 lineage in V_T at any maturation state (cDC1 + mcDC1).</body>
        </notes>
      </parameter>
      <parameter id="mw38927297_559f_43b3_8bb3_45f4940a5a03" name="cDC2_lineage_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">cDC2 lineage in V_T at any maturation state (cDC2 + mcDC2).</body>
        </notes>
      </parameter>
      <parameter id="mw36da2b0b_951e_4ea9_817a_3d5e0467737c" name="immune_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All leukocytes in V_T (T cells + macrophages + MDSC + DC). Excludes cancer cells and CAFs, unlike nucleated_total_T.</body>
        </notes>
      </parameter>
      <parameter id="mw3e3fd505_b195_49be_afb0_cd50299032c1" name="CD8_total_C" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Whole-repertoire CD8 T cells in V_C (per-clone naive pool scaled by div_CD8, plus the expanded antigen-specific clone).</body>
        </notes>
      </parameter>
      <parameter id="mwcf5db6fb_ba44_4e4c_8616_388a9a858584" name="CAF_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Activated cancer-associated fibroblasts in V_T (iCAF + myCAF + apCAF). Excludes quiescent qPSC.</body>
        </notes>
      </parameter>
    </listOfParameters>
