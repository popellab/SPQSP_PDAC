          <body xmlns="http://www.w3.org/1999/xhtml">apCAF proliferation rate (lower than iCAF/myCAF)</body>
        </notes>
      </parameter>
      <parameter id="mwd11e080d_170b_4de9_8481_9eaa07e36985" name="f_stroma_max" value="2.43" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF:cancer ratio — total carrying-capacity budget partitioned across iCAF/myCAF/apCAF</body>
        </notes>
      </parameter>
      <parameter id="mwf0020dd7_9b6c_4765_8629_20b813fc6d27" name="f_apCAF_of_total" value="0.1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF share of the total CAF carrying capacity. Default 0.1 from Elyada 2019 Fig 5D (apCAFs ~10% of PDAC CAFs). Free parameter in the stick-breaking simplex parameterization (paired with f_iCAF_of_non_apCAF).</body>
        </notes>
      </parameter>
      <parameter id="mwf9525177_763b_47b0_a82b_e0cc455f6992" name="f_iCAF_of_non_apCAF" value="0.222" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF share of the non-apCAF CAF mass (stick-breaking second step). Default 0.222 from Elyada 2019 Fig 5D — myCAF 0.7 + iCAF 0.2 of total → iCAF/(iCAF+myCAF) = 0.2/0.9 = 0.222. Free parameter in the stick-breaking simplex parameterization (paired with f_apCAF_of_total).</body>
        </notes>
      </parameter>
      <parameter id="mw6b0efc4e_4bfd_43ab_bf24_cd4860ae6d7d" name="k_col_myCAF_sec" value="5e-08" units="MWDERIVEDUNIT_milligram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw711f4f92_4598_46b2_9eb9_fd9756d88341" name="f_col_basal" value="0.15" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Basal fraction of collagen secretion (TGFb-independent)</body>
        </notes>
      </parameter>
      <parameter id="mwf9e192fe_1c0f_4214_9a41_684b9794578b" name="TGFb_50_CAF_act" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for CAF activation and interconversion</body>
        </notes>
      </parameter>
      <parameter id="mwb0696e46_fef5_4ddf_9331_1e1698199491" name="TGFb_50_col_sec" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for collagen secretion</body>
        </notes>
      </parameter>
      <parameter id="mw0132f6c8_6ead_4b69_8754_7e9e9a2083e9" name="k_col_deg" value="0.007" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Constitutive collagen degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw67f7a43f_5742_4edd_ac68_04e16418396c" name="k_MMP_M2" value="1e-08" units="MWDERIVEDUNIT_milliliter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">M2 macrophage MMP-mediated collagen degradation</body>
        </notes>
      </parameter>
      <parameter id="mwb144f252_973d_4ed5_89e1_dad003f29b7d" name="phi_cross_50" value="0.03" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction at 50% MMP-susceptibility (LOX-crosslinking shield)</body>
        </notes>
      </parameter>
      <parameter id="mw4eb0d0c5_74f8_43a0_8d62_5d689cb11e93" name="f_nascent" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Fraction of collagen susceptible to M2 MMP degradation (non-crosslinked)</body>
        </notes>
      </parameter>
      <parameter id="mw2e3284f4_dfee_4db8_8f7c_cecc75949b23" name="rho_collagen" value="0.103" units="MWDERIVEDUNIT_gram__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen packing density (material constant)</body>
        </notes>
      </parameter>
      <parameter id="mw69c9932a_d657_4b79_a21b_64fe897b8114" name="phi_collagen" value="0.12" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction (0-1). Bare-volume normalized; primary input for all ECM Hill functions.</body>
        </notes>
      </parameter>
      <parameter id="mwf3aa873d_58a2_47d0_b6bd_4f8c77f73fe7" name="k_qpsc_death" value="0.005" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of quiescent PSCs</body>
        </notes>
      </parameter>
      <parameter id="mw1f9e2004_aa68_4183_a6bd_e8cca1b0b754" name="k_iCAF_death" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw7fc11a31_abeb_4aa7_95cd_8fb23e4153db" name="k_myCAF_death" value="0.015" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw77261a60_9039_4a06_8dca_90e272de9d52" name="k_apCAF_death" value="0.03" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw018f06c4_6030_4135_a4ea_015e948ced9b" name="d_pore_ref" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference pore size in normal pancreas (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mwa3d03214_c278_4dd0_95a6_970cb724ac0e" name="phi_col_ref" value="0.046" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction in normal pancreas (reference)</body>
        </notes>
      </parameter>
      <parameter id="mwc6b3c198_7a4d_4441_b20f_3d123e60142e" name="d_crit_T" value="2.3" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for T cell migration arrest (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mwf38aaa89_960e_42c6_ae5f_ada6cdaa1fa4" name="d_crit_APC" value="2.1" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for APC migration arrest (podosome/MMP migration)</body>
        </notes>
      </parameter>
      <parameter id="mw21f89cfe_0a4e_4637_94f4_3a9a86c8fe8e" name="n_pore" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for pore-size exclusion sharpness</body>
        </notes>
      </parameter>
      <parameter id="mw75684d74_2d2f_4ec0_b0a7_95bf00b1650c" name="d_pore" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore size between collagen fibers (decreases with density)</body>
        </notes>
      </parameter>
      <parameter id="mwabf2a615_6c4c_4d83_8e8d_878b7cdb1a86" name="H_pore_T" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based T cell exclusion. 1=fully excluded, 0=free migration.</body>
        </notes>
      </parameter>
      <parameter id="mwbfe0806d_83db_4d18_a699_f1d2c46963e8" name="H_pore_APC" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based APC exclusion. DCs more deformable than T cells.</body>
        </notes>
      </parameter>
      <parameter id="mw29c4c28f_2cfb_423a_b888_2bcdf3eb2dd7" name="E_ref" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference stiffness at phi_col_ref (~1 kPa, dimensionless)</body>
        </notes>
      </parameter>
      <parameter id="mwf004cbb8_0dff_4023_953b_875049a4e5d0" name="n_stiff" value="1.8" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Power law exponent for stiffness-collagen relationship</body>
        </notes>
      </parameter>
      <parameter id="mw113e7658_5eba_4e9f_9b50_d6a303d18a38" name="E_50_Texh" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwca7f4bcf_7356_4a7a_8dbc_e46821e62696" name="n_Texh" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw43db0f06_fa21_4e8e_ae52_feaed453ae16" name="E_50_fib" value="5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for fibroblast mechanotransduction</body>
        </notes>
      </parameter>
      <parameter id="mwc3b90724_6726_4f70_99a3_85a365778a02" name="n_fib" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated fibroblast activation</body>
        </notes>
      </parameter>
      <parameter id="mw995476b9_8989_4d35_b1e6_ff7bdcf53b59" name="stiffness" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tissue stiffness (kPa-scaled, dimensionless). Power law of collagen density.</body>
        </notes>
      </parameter>
      <parameter id="mw0a0deea0_6b28_43a9_b877_ff46772d279d" name="H_stiff_Texh" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated T cell exhaustion (chronic mechanosensing, PD-L1)</body>
        </notes>
      </parameter>
      <parameter id="mw701dea1b_91ce_4726_b102_81fd697bdcf8" name="H_stiff_fib" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated fibroblast activation (YAP/TAZ mechanotransduction)</body>
        </notes>
      </parameter>
      <parameter id="mwa70032af_269c_48a0_b2f0_90cedcad18c5" name="phi_col_50_Kmax" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">phi_collagen for 50% carrying capacity reduction. &gt;1 = ECM barrier never reaches half-max, consistent with stroma-depletion worsening PDAC (Rhim 2014, Ozdemir 2014).</body>
        </notes>
      </parameter>
      <parameter id="mw2c1f4132_b7ed_4933_a379_e7a82571ac48" name="K_stiff_niche" value="100000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF population sustained by stiff ECM alone (mechanotransduction niche via YAP/TAZ). Allows fibrotic scar persistence post-therapy.</body>
        </notes>
      </parameter>
      <parameter id="mw08d284d9_a79a_4fa9_8e57_aaff1cc19665" name="k_stroma_support" value="1.05" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stromal contribution to cancer carrying capacity. Joint submodel posterior median 1.05 (sigma 0.70) from Xu 2010 + Hwang 2008 (orthotopic dose-response). Hwang 1:5 vs 1:1 tumor mass scaling supports a small per-CAF contribution to cancer C_max.</body>
        </notes>
      </parameter>
      <parameter id="mw4f19dc92_5368_40f4_83c9_8a89ae67920f" name="vol_qPSCcell" value="1500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of quiescent PSC</body>
        </notes>
      </parameter>
      <parameter id="mwc57c8a33_2ca3_4543_b568_2fbcdade5839" name="vol_iCAFcell" value="2000" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of iCAF</body>
        </notes>
      </parameter>
      <parameter id="mw36d74659_9357_4839_8280_c513da00e562" name="vol_myCAFcell" value="3500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of myCAF</body>
        </notes>
      </parameter>
      <parameter id="mw295bce19_33b9_4fdf_af80_a71aab68d73c" name="vol_apCAFcell" value="2500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of apCAF</body>
        </notes>
      </parameter>
      <parameter id="mwdaabf415_939b_493b_8287_5dac2afc4e98" name="k_CXCL12_sec_iCAF" value="1e-10" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 secretion rate by iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwbee1116e_33ea_42d6_bfbf_aca7d5476ccf" name="k_CXCL12_deg" value="2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mwa67a5b0f_6d31_4219_b851_95fbb4b8eeda" name="CXCL12_50_Texcl" value="2" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for CXCL12-mediated T cell exclusion</body>
        </notes>
      </parameter>
      <parameter id="mwd1f4dfa3_8662_4890_bcf8_2276d827cb6a" name="k_IL6_sec_iCAF" value="2e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 secretion rate by iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwfb8cd2eb_e33b_4edf_bd78_f43c427d8c7c" name="k_IL6_deg" value="16" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw2f49e23f_801b_468a_b0a3_0e223656f2e1" name="IL6_50_MDSC" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 enhancement of MDSC recruitment</body>
        </notes>
      </parameter>
      <parameter id="mw4ebfc50a_d6a1_4398_a473_064dff978415" name="IL6_50_M2" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 promotion of M2 polarization</body>
        </notes>
      </parameter>
      <parameter id="mwee4e26e6_b7cd_4b28_96d3_f0e6e457908b" name="IL6_50_iCAF" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 autocrine feedback promoting iCAF phenotype</body>
        </notes>
      </parameter>
      <parameter id="mwce19b688_1d74_402f_8120_1d6048c814dd" name="f_IL6_iCAF" value="3" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Fold-enhancement of iCAF formation by IL-6 feedback</body>
        </notes>
      </parameter>
      <parameter id="mwf893a354_7935_423f_98ea_4b76bb92f9cd" name="H_IL6_iCAF" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL-6 autocrine feedback on iCAF phenotype</body>
        </notes>
      </parameter>
      <parameter id="mwe79d8e55_482a_4f8c_b301_07388f86f444" name="k_IL1_sec" value="1e-12" units="MWDERIVEDUNIT_nanomole__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-1alpha secretion rate by cancer cells</body>
        </notes>
      </parameter>
      <parameter id="mw2df4bee2_19bd_4190_b088_06eaec71482f" name="k_IL1_deg" value="6.93" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-1alpha degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw0fb7626e_cff7_42c0_bdeb_efe38a9f4a79" name="IL1_50" value="0.01" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Basal EC50 for IL-1-driven iCAF formation</body>
        </notes>
      </parameter>
      <parameter id="mw27abab41_16bf_4c3a_b19e_b7263dbeb139" name="n_IL1" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for IL-1-driven iCAF formation</body>
        </notes>
      </parameter>
      <parameter id="mwcb78fe4a_3ac5_42cc_bc26_86bc192a6f28" name="TGFb_50_IL1R1" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for IL-1R1 downregulation</body>
        </notes>
      </parameter>
      <parameter id="mw4714221c_8a0f_4744_89db_032a15ecd63b" name="Emax_IL1R1" value="5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max fold-shift of IL-1 EC50 by TGFb-driven IL-1R1 repression</body>
        </notes>
      </parameter>
      <parameter id="mwf4135a9d_52c7_4de3_ac40_8b6179c7e59d" name="IL1_ratio" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Dimensionless IL-1 ratio: IL1 / effective EC50</body>
        </notes>
      </parameter>
      <parameter id="mwcf4454db_2c36_45b1_b344_1f3274ddce01" name="H_IL1_eff" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective IL-1 Hill function. TGFb antagonizes by increasing effective EC50 via IL-1R1 repression (saturating).</body>
        </notes>
      </parameter>
      <parameter id="mwe21561be_c2e5_4a37_8fec_b6253636718f" name="k_vas_myCAF_sec" value="0.002" units="MWDERIVEDUNIT_picogram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw2613e621_3be3_44c4_a569_db19548447e2" name="k_P1_up_apCAF" value="1.44" units="MWDERIVEDUNIT_1__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen uptake rate by apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw4115aa69_7168_444e_a215_a9f4644f7a2b" name="k_apCAF_Treg" value="0.03" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max Th-&gt;Treg conversion rate via apCAF</body>
        </notes>
      </parameter>
      <parameter id="mw53d2a321_cf3f_4ea8_8993_96428cf38c83" name="K_apCAF_Treg" value="100000000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max apCAF count for Treg induction saturation</body>
        </notes>
      </parameter>
      <parameter id="mwcf678a6f_a338_4c02_8a27_1b820cbbf7de" name="P1_50_apCAF" value="1e-09" units="MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent Treg induction by apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw6c853d30_ce4c_4fa9_bc6d_0a9572efa152" name="aPSC_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total activated PSC count (iCAF+myCAF+apCAF). Backward compatibility for test statistics.</body>
        </notes>
      </parameter>
      <parameter id="mw5981a309_0f02_437c_baac_583373a57e8c" name="k_TGFb_sec_myCAF" value="2e-10" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGF-β secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw6af7c56d_308c_40cf_a132_d770044adffd" name="k_CXCL12_sec_cancer" value="5e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 secretion rate by tumor cells</body>
        </notes>
      </parameter>
      <parameter id="mw6b510292_6800_46f4_8351_5cefeec2ec9e" name="k_CCL5_sec_iCAF" value="3e-11" units="MWDERIVEDUNIT_nanomole__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CCL5 secretion rate by iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw8b4b3d97_bae4_4cf1_bf1c_133f46d68a6f" name="H_P1_apCAF" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for antigen-dependent apCAF Treg induction</body>
        </notes>
      </parameter>
      <parameter id="mw98ffbf32_4cc2_41e2_bab9_7eb44af0dd10" name="k_GVAX_clearance" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GVAX cell clearance rate from tumor</body>
        </notes>
      </parameter>
      <parameter id="mwaf034a1b_7c47_4ed2_968d_c61fb8f7ec1b" name="V_ID_volume" value="0.0001" units="MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of intradermal injection site (~0.1 mL)</body>
        </notes>
      </parameter>
      <parameter id="mwd91d0a7e_9121_4e8b_b446_37a246bfbf4c" name="k_GMCSF_prod" value="1e-08" units="MWDERIVEDUNIT_nanomolarity__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF production rate per GVAX cell per day</body>
        </notes>
      </parameter>
      <parameter id="mwd34bfd60_ac9d_47c0_8594_c6b3b0134069" name="k_GMCSF_deg" value="5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF degradation/clearance rate (half-life ~3 hours)</body>
        </notes>
      </parameter>
      <parameter id="mw1fe4b6ec_76ac_4bf5_a037_f71741d103bb" name="k_APC_recruit_ID" value="100000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC recruitment rate to intradermal injection site</body>
        </notes>
      </parameter>
      <parameter id="mw8ce62700_390b_4f05_a1d7_1546a93b24da" name="EC50_GMCSF" value="0.00294005042817446" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for GM-CSF-mediated APC recruitment and maturation</body>
        </notes>
      </parameter>
      <parameter id="mw667df061_dc38_4099_aa6a_e511da4de35a" name="k_APC_mature_ID" value="2.72805986290677" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC maturation rate at injection site</body>
        </notes>
      </parameter>
      <parameter id="mwcb880f2e_4f0d_441a_acf3_92510261becf" name="k_APC_mig_ID_LN" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC migration rate from injection site to lymph nodes</body>
        </notes>
      </parameter>
      <parameter id="mw2dda43e0_9dc5_4cef_af2e_cbdb9c97b93a" name="k_APC_death_ID" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC death rate at injection site</body>
        </notes>
      </parameter>
      <parameter id="mwfa28c52c_24ea_43b5_a5f4_c21ed6867010" name="sigma_P1_per_mAPC" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen consumed per APC maturation event at injection site</body>
        </notes>
      </parameter>
      <parameter id="mw102da47b_b029_4e26_bf29_820c335fb58b" name="EC50_P1_mature" value="0.1" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent APC maturation. Lowered from 10 nM to 0.1 nM on 2026-04-21 (Fix 3): with the 10 nM value, V_ID.P1_GVAX (~0.009 nM steady state) produced a Hill factor of ~0.0009 in J_mature_ID, so GVAX-derived antigen was never a meaningful contributor to APC maturation — maturation proceeded almost entirely via the GMCSF + baseline APC terms. 0.1 nM is an estimated value in the nanomolar-affinity range typical of peptide/antigen-receptor interactions; not anchored to a specific primary source. Candidate for submodel-target extraction.</body>
        </notes>
      </parameter>
      <parameter id="mw57a6d31a_aa30_437e_86b1_1268f980f706" name="K_APC_ID" value="1000000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mwd6d27963_9d43_41e9_b918_0df3b646164f" name="k_APC_recruit0" value="100" units="MWDERIVEDUNIT_cell__day" constant="true"/>
      <parameter id="mw977c91f5_305e_4760_8b4f_fe3b066a132e" name="k_mAPC_death_ID" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mwc6b119d2_060c_4c7c_b66f_ebd0f01f3cc5" name="y_Ag_per_cell" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true"/>
      <parameter id="mw33b3fc98_7231_49a7_a58a_12ccfd331f30" name="k_P1_deg_ID" value="10" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mw9b8ad41a_09f3_4021_afd7_668837f274a7" name="K_APC_mig" value="100000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mw465fa5a3_6d7c_4810_928e_c464c9739231" name="k_cDC1_Ag_transfer" value="1e-07" units="MWDERIVEDUNIT_1__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen-transfer rate constant: migratory mcDC2 -&gt; resident cDC1 cross-licensing (Ferris 2022 PMID: 35648641; Mueller 2017 Eur J Immunol)</body>
        </notes>
      </parameter>
      <parameter id="mwbea79adc_2b8d_42ae_b988_071e9ba7e774" name="H_GMCSF_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mwe13c0d15_6b64_4ec2_a2a7_76f6bfac2e83" name="J_mature_ID" value="0" units="MWDERIVEDUNIT_cell__day" constant="false"/>
      <parameter id="mwf1ff92c0_28f1_4051_92e5_dad3d5580f56" name="k_Cy_clear" value="2.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide clearance rate</body>
        </notes>
      </parameter>
      <parameter id="mw1c1ac2c7_c2bc_4fcc_a061_9052e5ae7235" name="k_Cy_Treg_deplete" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Maximum Treg depletion rate by cyclophosphamide</body>
        </notes>
      </parameter>
      <parameter id="mwe0f5ede4_16bc_4c0e_80ee_0a720837e96e" name="Cy_50_Treg" value="50" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_gram" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide concentration for 50% Treg depletion</body>
        </notes>
      </parameter>
      <parameter id="mw54859fe9_3def_4e9f_9b7e_d880210e60d7" name="nucleated_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All nucleated cells in V_T (cancer + immune + CAFs). Used as the denominator for _pct_ calibration targets matching mIHC &quot;% of all nucleated cells&quot; measurements.</body>
        </notes>
      </parameter>
    </listOfParameters>
