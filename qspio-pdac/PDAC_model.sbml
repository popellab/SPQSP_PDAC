      <parameter id="mw5b8639a9_4514_488d_80d7_337540543040" name="H_Mac_C" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for overall checkpoint inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mwaa7452c8_efc2_4f73_8ad9_b01350aaa63c" name="H_PD1_M" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for PD1-mediated inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw07a1d48e_5a1c_41e2_b080_a06937bf4a85" name="H_SIRPa" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for SIRPa-mediated inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mwdc99866e_f430_47dd_b380_07ed11c3c666" name="C_CD47" value="400" units="MWDERIVEDUNIT_molecule__micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CD47 expression on cancer cells </body>
        </notes>
      </parameter>
      <parameter id="mwc1c9e9ab_edfd_40bc_8382_eb86e82192ac" name="M_PD1_total" value="12500" units="MWBUILTINUNIT_molecule" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">PD-1 expression on macrophages </body>
        </notes>
      </parameter>
      <parameter id="mw79f47a5e_5caa_4249_907d_10d635608b68" name="M_SIRPa" value="100" units="MWDERIVEDUNIT_molecule__micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">SIRPa expression on macrophages </body>
        </notes>
      </parameter>
      <parameter id="mwd4c33014_2c8d_49c7_8a46_bfdb6a256830" name="A_Mcell" value="1385.4423602331" units="MWDERIVEDUNIT_micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Surface area of the macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw2e98d3f1_9dcb_4c06_8fc8_7ce1aea5e96c" name="IL10_50_phago" value="270" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal IL-10 level for phagocytosis by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw0e9045c8_6828_4576_bc8d_eaf2fc109cb4" name="K_M1_phago" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Association coefficient for macrophage and cancer cell </body>
        </notes>
      </parameter>
      <parameter id="mw14f358a9_d8bc_4d59_ac9d_817dcfc6b47a" name="M_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of macrophages </body>
        </notes>
      </parameter>
      <parameter id="mwf4ea232f_1899_4e3d_9987_35284ea10aa9" name="H_IL10_APC" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill: IL-10 suppression of DC maturation (cDC1/cDC2)</body>
        </notes>
      </parameter>
      <parameter id="mw01b63673_14f4_4e3a_b6e1_8dced34e1f24" name="H_IL10_Treg" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill: IL-10 amplification of Treg-mediated CD8 exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwd070b96e_fbdf_4e37_bf8f_7435d2a23ab4" name="H_IL10_phago" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL10-mediated inhibition on phagocytosis </body>
        </notes>
      </parameter>
      <parameter id="mwcf31545c_da1d_4807_b6f2_6a3fcfcb9dde" name="H_IL12" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL12 </body>
        </notes>
      </parameter>
      <parameter id="mwcc9a88c1_1464_45da_9cbe_cb00e261e334" name="H_IL6_M2" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL-6 promotion of M2 macrophage polarization</body>
        </notes>
      </parameter>
      <parameter id="mw91aa4f1a_a9a7_4d81_89b7_017067531b0d" name="phi_M2_skew" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Averaged M2-polarizing milieu drive (TGFb/IL-10/IL-6); sets both the fraction of recruited monocytes differentiating directly to M2 and the M1-&gt;M2 polarization drive</body>
        </notes>
      </parameter>
      <parameter id="mwd16b0d63_c72f_42a6_87f2_92a1a1019928" name="k_CAF_encounter" value="1000000" units="MWDERIVEDUNIT_cell__milliliter_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of encountering resident PSCs as tumor expands into pancreas</body>
        </notes>
      </parameter>
      <parameter id="mwca1bab5b_a397_4d0e_b153_379e5e06d4bb" name="k_CAF_const" value="2000000" units="MWDERIVEDUNIT_cell__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Constitutive PSC density in pancreatic tissue</body>
        </notes>
      </parameter>
      <parameter id="mwc05937eb_135e_4c71_ae0d_9f33601e6d9f" name="k_PSC_to_myCAF" value="0.2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;myCAF activation rate (TGFb-driven)</body>
        </notes>
      </parameter>
      <parameter id="mw6893607a_185a_4aad_b1ea_908d96bbfdf9" name="k_PSC_to_iCAF" value="0.2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;iCAF activation rate (IL-1-driven)</body>
        </notes>
      </parameter>
      <parameter id="mw3b6fc86c_49fb_4f08_b03c_74499f98b34f" name="k_PSC_to_apCAF" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;apCAF activation rate (constitutive low)</body>
        </notes>
      </parameter>
      <parameter id="mw1714496b_f019_4149_a0f8_6a55e280f2f0" name="k_iCAF_to_myCAF" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF-&gt;myCAF interconversion (TGFb-driven)</body>
        </notes>
      </parameter>
      <parameter id="mw3cdffbf7_9a2d_4261_bf51_d0cab8571fcf" name="k_myCAF_to_iCAF" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">myCAF-&gt;iCAF interconversion (IL-1-driven)</body>
        </notes>
      </parameter>
      <parameter id="mwa2f9a6c1_2d14_48ac_a792_54ac90e07de1" name="k_myCAF_prolif" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">myCAF proliferation rate</body>
        </notes>
      </parameter>
      <parameter id="mw5b7e5a80_0abc_408b_9cea_c17ae374ef3d" name="k_iCAF_prolif" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF proliferation rate</body>
        </notes>
      </parameter>
      <parameter id="mwdb75ffb1_6433_421d_9e11_d54b4f3a9944" name="k_apCAF_prolif" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF proliferation rate (lower than iCAF/myCAF)</body>
        </notes>
      </parameter>
      <parameter id="mw033f0c05_68dc_48f2_9217_300cc12055be" name="f_stroma_max" value="2.43" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF:cancer ratio — total carrying-capacity budget partitioned across iCAF/myCAF/apCAF</body>
        </notes>
      </parameter>
      <parameter id="mw015ff057_6616_4a17_8435_cbaa5158dc22" name="f_apCAF_of_total" value="0.1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF share of the total CAF carrying capacity. Default 0.1 from Elyada 2019 Fig 5D (apCAFs ~10% of PDAC CAFs). Free parameter in the stick-breaking simplex parameterization (paired with f_iCAF_of_non_apCAF).</body>
        </notes>
      </parameter>
      <parameter id="mwd4e57e54_f8e6_43c3_b65f_408cbb0a56f8" name="f_iCAF_of_non_apCAF" value="0.222" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF share of the non-apCAF CAF mass (stick-breaking second step). Default 0.222 from Elyada 2019 Fig 5D — myCAF 0.7 + iCAF 0.2 of total → iCAF/(iCAF+myCAF) = 0.2/0.9 = 0.222. Free parameter in the stick-breaking simplex parameterization (paired with f_apCAF_of_total).</body>
        </notes>
      </parameter>
      <parameter id="mwb93142bb_87f1_4af3_8813_08f6ca3b31d9" name="k_col_myCAF_sec" value="5e-08" units="MWDERIVEDUNIT_milligram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwdfd8eb8e_812b_4d0a_81f9_1e41c4c22ca8" name="f_col_basal" value="0.15" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Basal fraction of collagen secretion (TGFb-independent)</body>
        </notes>
      </parameter>
      <parameter id="mw83ad017a_6fbb_4cdc_a98d_047f1f56c5e0" name="TGFb_50_CAF_act" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for CAF activation and interconversion</body>
        </notes>
      </parameter>
      <parameter id="mw8127e533_2c04_4434_93f4_aa6dc22b0f2f" name="TGFb_50_col_sec" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for collagen secretion</body>
        </notes>
      </parameter>
      <parameter id="mw4c7fecc0_4445_4450_b0e8_a1551e5a380b" name="k_col_deg" value="0.007" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Constitutive collagen degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mwb0b33609_66d3_494e_96ea_6213db8d0c76" name="k_MMP_M2" value="1e-08" units="MWDERIVEDUNIT_milliliter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">M2 macrophage MMP-mediated collagen degradation</body>
        </notes>
      </parameter>
      <parameter id="mw0fcd8a99_8b43_4fde_8ac0_8b77440ea9e6" name="phi_cross_50" value="0.03" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction at 50% MMP-susceptibility (LOX-crosslinking shield)</body>
        </notes>
      </parameter>
      <parameter id="mw6904cc0c_d63e_4ec7_93d9_8bda4e1b5d1a" name="f_nascent" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Fraction of collagen susceptible to M2 MMP degradation (non-crosslinked)</body>
        </notes>
      </parameter>
      <parameter id="mwaa558a6f_66c2_42ad_ab7e_ee747efe9444" name="rho_collagen" value="0.103" units="MWDERIVEDUNIT_gram__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen packing density (material constant)</body>
        </notes>
      </parameter>
      <parameter id="mw4af65d1a_8c30_441c_9a8b_be30b01d436d" name="phi_collagen" value="0.12" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction (0-1). Bare-volume normalized; primary input for all ECM Hill functions.</body>
        </notes>
      </parameter>
      <parameter id="mw92dd4871_74bf_45ed_a2b5_99964eb63289" name="k_qpsc_death" value="0.005" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of quiescent PSCs</body>
        </notes>
      </parameter>
      <parameter id="mwf26fd653_c905_4200_854b_70e76ffd133d" name="k_iCAF_death" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw51d3485e_8366_4ac6_8feb_1b8153d5170d" name="k_myCAF_death" value="0.015" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw2f2be196_fd14_4aba_a9d5_5c802a0046b7" name="k_apCAF_death" value="0.03" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw788a77d3_776f_44c1_a0db_686a5694be37" name="d_pore_ref" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference pore size in normal pancreas (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mw8842a043_3d2e_4884_b031_55dfaf7ee63d" name="phi_col_ref" value="0.046" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction in normal pancreas (reference)</body>
        </notes>
      </parameter>
      <parameter id="mwd0f52267_a154_4355_af60_b3d42eec3500" name="d_crit_T" value="2.3" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for T cell migration arrest (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mw26d1a83b_fadc_4ab8_aaf2_6fe44314b553" name="d_crit_APC" value="2.1" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for APC migration arrest (podosome/MMP migration)</body>
        </notes>
      </parameter>
      <parameter id="mwd3329892_ed61_45bb_99ea_c5851d1a6a9a" name="n_pore" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for pore-size exclusion sharpness</body>
        </notes>
      </parameter>
      <parameter id="mw5130e74e_1aec_4d7f_b5f2_41e6ca6ab3e3" name="d_pore" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore size between collagen fibers (decreases with density)</body>
        </notes>
      </parameter>
      <parameter id="mw08c9e665_62a0_445f_8097_a138df704088" name="H_pore_T" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based T cell exclusion. 1=fully excluded, 0=free migration.</body>
        </notes>
      </parameter>
      <parameter id="mw34033e3a_cd3c_4107_8ee6_af7b2544696e" name="H_pore_APC" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based APC exclusion. DCs more deformable than T cells.</body>
        </notes>
      </parameter>
      <parameter id="mw2a213ce2_fe2e_4fa1_8392_1d8a7887724c" name="E_ref" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference stiffness at phi_col_ref (~1 kPa, dimensionless)</body>
        </notes>
      </parameter>
      <parameter id="mw82f355c9_20f0_4732_a41b_5f404602f141" name="n_stiff" value="1.8" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Power law exponent for stiffness-collagen relationship</body>
        </notes>
      </parameter>
      <parameter id="mwba2338c5_222e_4a2f_a4c3_2255a179ca75" name="E_50_Texh" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwa855f06b_4ad4_4923_b7ba_1a9db71220a8" name="n_Texh" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwe48d34f4_fd44_4e32_9d48_5a14fc6d52a6" name="E_50_fib" value="5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for fibroblast mechanotransduction</body>
        </notes>
      </parameter>
      <parameter id="mw14d9e6be_94b2_430c_8361_6b8b72dc1b97" name="n_fib" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated fibroblast activation</body>
        </notes>
      </parameter>
      <parameter id="mw6f7397e6_b30f_4129_a601_8e5278c610c7" name="stiffness" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tissue stiffness (kPa-scaled, dimensionless). Power law of collagen density.</body>
        </notes>
      </parameter>
      <parameter id="mw30692a33_9f05_4e5c_b82b_2478ccfa9251" name="H_stiff_Texh" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated T cell exhaustion (chronic mechanosensing, PD-L1)</body>
        </notes>
      </parameter>
      <parameter id="mwb8762319_5eee_4c43_af03_16ea265f44ab" name="H_stiff_fib" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated fibroblast activation (YAP/TAZ mechanotransduction)</body>
        </notes>
      </parameter>
      <parameter id="mwedc79e02_f40a_44db_b83c_9048d760d624" name="phi_col_50_Kmax" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">phi_collagen for 50% carrying capacity reduction. &gt;1 = ECM barrier never reaches half-max, consistent with stroma-depletion worsening PDAC (Rhim 2014, Ozdemir 2014).</body>
        </notes>
      </parameter>
      <parameter id="mwfd44ced2_21bd_4810_89df_16117a37a6d9" name="phi_col_max" value="0.5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Physical packing ceiling for collagen volume fraction (logistic secretion saturation). ~0.5 = peak fibrillar collagen packing in dense PDAC stroma (placeholder pending primary-source anchor).</body>
        </notes>
      </parameter>
      <parameter id="mwbc9d5ddf_27b4_406b_9d6f_a5574a5f00d4" name="K_stiff_niche" value="100000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF population sustained by stiff ECM alone (mechanotransduction niche via YAP/TAZ). Allows fibrotic scar persistence post-therapy.</body>
        </notes>
      </parameter>
      <parameter id="mw0b0b8f63_59d9_472a_8b8b_849c97cb1975" name="k_stroma_support" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Aggregate stromal contribution scale (global multiplier on subtype-weighted CAF sum in C_max). Constrained by Xu 2010 + Hwang 2008 orthotopic dose-response submodel targets.</body>
        </notes>
      </parameter>
      <parameter id="mw7180ab82_66ca_4dc5_89f4_25cee0ed287e" name="k_stroma_myCAF" value="1.4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-myCAF contribution to cancer C_max. myCAFs build PDAC desmoplasia (collagen/CXCL12/VEGF) — dominant structural CAF subtype (Elyada 2019; Dominguez 2020).</body>
        </notes>
      </parameter>
      <parameter id="mw9dea5b7b_626d_49e1_8a36_272fb3e875fc" name="k_stroma_iCAF" value="0.28" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-iCAF contribution to cancer C_max. iCAFs are inflammatory secretors (IL-6/CXCL12), low αSMA, located distally from tumor — minimal structural carrying-capacity role (Elyada 2019, Öhlund 2017).</body>
        </notes>
      </parameter>
      <parameter id="mw42d4b31b_7cee_4c9d_b646_e8fb9c42a323" name="k_stroma_apCAF" value="0.07" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-apCAF contribution to cancer C_max. apCAFs are rare (&lt;5% of CAFs) MHC-II+ tolerogenic antigen-presenters — predominantly immunomodulatory (induce Treg expansion in antigen-specific manner), not structural (Elyada 2019, Huang 2022 Cancer Cell).</body>
        </notes>
      </parameter>
      <parameter id="mw89d83089_8048_4ad9_8925_2b2c943b845d" name="C_cap0" value="1700000000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Baseline C-independent carrying-capacity floor (cells): parenchymal volume the lesion occupies pre-desmoplasia. UN-ANCHORED fitted structural handle (derivedFrom={}); value 1.7e9 is calibrated as the tumor_fold handle coupled with k_C1_growth~0.008, NOT a literature value. Candidate future submodel anchor: accessible parenchymal/lobular volume / vol_cell (queued in reconciliation_targets.csv) -- but GitHub #229 (V_T&lt;-&gt;C_max unification) would DERIVE and dissolve it. Default 0 recovers prior stroma+vascular-only C_max exactly.</body>
        </notes>
      </parameter>
      <parameter id="mwbf4ee94e_e73b_4414_b97f_6fce0028962b" name="vol_qPSCcell" value="1500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
