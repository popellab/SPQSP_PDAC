      <species id="mwa990c000_a0ca_4021_8a7c_b4a00b3d1fc2" name="C_x" compartment="mw026862eb_87b1_405a_b373_64e65f51ca39" initialAmount="0" substanceUnits="MWUSERUNIT_cell" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false">
