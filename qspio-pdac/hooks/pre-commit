#!/bin/bash
# Pre-commit hook: re-export SBML when model files change
#
# Install: ln -sf ../../hooks/pre-commit .git/hooks/pre-commit

# Check if any .m files in core/modules/, core/model_compilation/, or scripts/ changed
if git diff --cached --name-only | grep -qE '(core/modules/|core/model_compilation/|scripts/immune_oncology_model_PDAC\.m|parameters/)'; then
    echo "Model files changed — re-exporting SBML..."
    matlab -batch "run('scripts/export_sbml.m')" 2>&1
    if [ $? -ne 0 ]; then
        echo "SBML export failed. Commit aborted."
        exit 1
    fi
    git add PDAC_model.sbml
    echo "PDAC_model.sbml updated and staged."
fi