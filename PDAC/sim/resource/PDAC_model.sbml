        </notes>
      </parameter>
      <parameter id="mw595de672_6526_4438_b316_7a8818c5bdf8" name="H_pore_T" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based T cell exclusion. 1=fully excluded, 0=free migration.</body>
        </notes>
      </parameter>
      <parameter id="mwea570b01_6d80_42cc_8b2c_5dd8bb7c7f6e" name="H_pore_APC" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based APC exclusion. DCs more deformable than T cells.</body>
        </notes>
      </parameter>
      <parameter id="mw1819f33f_fa22_4f19_bb4b_26c36722e0c2" name="E_ref" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference stiffness at phi_col_ref (~1 kPa, dimensionless)</body>
        </notes>
      </parameter>
      <parameter id="mwff0664ba_37ef_48b4_a38f_e173da2576c4" name="n_stiff" value="1.8" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Power law exponent for stiffness-collagen relationship</body>
        </notes>
      </parameter>
      <parameter id="mwce067339_9ab1_482d_9ef1_c2ce535540d2" name="E_50_Texh" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw42822010_bd59_4488_aee2_0efbc33d6b9b" name="n_Texh" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw7b9d739d_b13d_4f57_bfca_1b7563a692ac" name="E_50_fib" value="5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for fibroblast mechanotransduction</body>
        </notes>
      </parameter>
      <parameter id="mwc7766109_7afa_49d0_bb8a_0e0beef9027c" name="n_fib" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated fibroblast activation</body>
        </notes>
      </parameter>
      <parameter id="mw51319e94_dd11_4323_8744_c7e3258e9d69" name="stiffness" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tissue stiffness (kPa-scaled, dimensionless). Power law of collagen density.</body>
        </notes>
      </parameter>
      <parameter id="mw6968a8d9_7426_4567_ad75_67c0d5699dc2" name="H_stiff_Texh" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated T cell exhaustion (chronic mechanosensing, PD-L1)</body>
        </notes>
      </parameter>
      <parameter id="mw4eb1cd02_29b4_4a19_9649_7b39ca89dcc6" name="H_stiff_fib" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated fibroblast activation (YAP/TAZ mechanotransduction)</body>
        </notes>
      </parameter>
      <parameter id="mw1d10ca49_a456_4b0c_acdc_5ecb1f3b3efa" name="phi_col_50_Kmax" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">phi_collagen for 50% carrying capacity reduction. &gt;1 = ECM barrier never reaches half-max, consistent with stroma-depletion worsening PDAC (Rhim 2014, Ozdemir 2014).</body>
        </notes>
      </parameter>
      <parameter id="mwab1334b9_e3e5_43ca_8102_708168bc3911" name="K_stiff_niche" value="100000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF population sustained by stiff ECM alone (mechanotransduction niche via YAP/TAZ). Allows fibrotic scar persistence post-therapy.</body>
        </notes>
      </parameter>
      <parameter id="mw0f9152ce_6452_4def_8aab_0a0d0533f346" name="k_stroma_support" value="1.05" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stromal contribution to cancer carrying capacity. Joint submodel posterior median 1.05 (sigma 0.70) from Xu 2010 + Hwang 2008 (orthotopic dose-response). Hwang 1:5 vs 1:1 tumor mass scaling supports a small per-CAF contribution to cancer C_max.</body>
        </notes>
      </parameter>
      <parameter id="mw81e7c66b_f6fb_4455_bac8_dc2f4045defd" name="vol_qPSCcell" value="1500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of quiescent PSC</body>
        </notes>
      </parameter>
      <parameter id="mw69c9dc77_ec93_4c59_83df_a97991172cd4" name="vol_iCAFcell" value="2000" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of iCAF</body>
        </notes>
      </parameter>
      <parameter id="mw6eb708d2_2141_4d09_ba6a_08a98e59e409" name="vol_myCAFcell" value="3500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of myCAF</body>
        </notes>
      </parameter>
      <parameter id="mw14a39fc9_0281_44e7_ac87_a76146107d8e" name="vol_apCAFcell" value="2500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of apCAF</body>
        </notes>
      </parameter>
      <parameter id="mw29b5a694_02f9_4e77_8159_7dd777e8dcea" name="k_CXCL12_sec_iCAF" value="1e-10" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 secretion rate by iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw25deafb2_24d4_4c2f_bc2f_e98741bd4c1b" name="k_CXCL12_deg" value="2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw2f1fd9a4_ddaa_4373_963a_1f90220f04fb" name="CXCL12_50_Texcl" value="2" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for CXCL12-mediated T cell exclusion</body>
        </notes>
      </parameter>
      <parameter id="mwc0519250_d1b0_4fb5_a2d1_8a556e99820d" name="k_IL6_sec_iCAF" value="2e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 secretion rate by iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw73a9ba92_48ed_4d36_bb73_e80e1652d23f" name="k_IL6_deg" value="16" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw900d5e36_79d4_4468_a23a_68d91d154f97" name="IL6_50_MDSC" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 enhancement of MDSC recruitment</body>
        </notes>
      </parameter>
      <parameter id="mwc96d097b_4b9a_4065_8668_02e6ec5ae20c" name="IL6_50_M2" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 promotion of M2 polarization</body>
        </notes>
      </parameter>
      <parameter id="mw114401ea_6ed1_4a1d_baec_96805d7e10d8" name="IL6_50_iCAF" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 autocrine feedback promoting iCAF phenotype</body>
        </notes>
      </parameter>
      <parameter id="mwe02fcde4_2ccd_4347_afde_af3c86aa3c37" name="f_IL6_iCAF" value="3" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Fold-enhancement of iCAF formation by IL-6 feedback</body>
        </notes>
      </parameter>
      <parameter id="mw34691f38_51ae_4f03_8217_0a092247599f" name="H_IL6_iCAF" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL-6 autocrine feedback on iCAF phenotype</body>
        </notes>
      </parameter>
      <parameter id="mwbce324b8_5634_4cca_bff2_a5c1e4200e4f" name="k_IL1_sec" value="1e-12" units="MWDERIVEDUNIT_nanomole__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-1alpha secretion rate by cancer cells</body>
        </notes>
      </parameter>
      <parameter id="mwef9239fd_bf25_4c59_a963_c14ac21a1262" name="k_IL1_deg" value="6.93" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-1alpha degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw492b6fae_5a68_4fe2_90bd_4fc4e5b47b25" name="IL1_50" value="0.01" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Basal EC50 for IL-1-driven iCAF formation</body>
        </notes>
      </parameter>
      <parameter id="mw7af93618_96cb_40d6_86c2_770886a984be" name="n_IL1" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for IL-1-driven iCAF formation</body>
        </notes>
      </parameter>
      <parameter id="mw53894e8e_e22f_402f_9a0c_82f9b582ffd3" name="TGFb_50_IL1R1" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for IL-1R1 downregulation</body>
        </notes>
      </parameter>
      <parameter id="mw260f6f49_f3e3_4b0f_8654_1d71bed8a0d0" name="Emax_IL1R1" value="5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max fold-shift of IL-1 EC50 by TGFb-driven IL-1R1 repression</body>
        </notes>
      </parameter>
      <parameter id="mwef221249_c824_4b05_a7aa_a4df5aa96140" name="IL1_ratio" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Dimensionless IL-1 ratio: IL1 / effective EC50</body>
        </notes>
      </parameter>
      <parameter id="mw9aca2598_6056_4e99_8fea_390120d116b0" name="H_IL1_eff" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective IL-1 Hill function. TGFb antagonizes by increasing effective EC50 via IL-1R1 repression (saturating).</body>
        </notes>
      </parameter>
      <parameter id="mwa294c70c_3ec7_4aad_9412_06468242198f" name="k_vas_myCAF_sec" value="0.002" units="MWDERIVEDUNIT_picogram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw2a707ceb_012d_44ad_9d2f_2cf2d4f0c0a6" name="k_P1_up_apCAF" value="1.44" units="MWDERIVEDUNIT_1__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen uptake rate by apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw698a1675_854e_4f0d_b5ec_bd40ea790de6" name="k_apCAF_Treg" value="0.03" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max Th-&gt;Treg conversion rate via apCAF</body>
        </notes>
      </parameter>
      <parameter id="mwa016f692_1a49_42cc_922b_7389721226c3" name="K_apCAF_Treg" value="100000000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max apCAF count for Treg induction saturation</body>
        </notes>
      </parameter>
      <parameter id="mwc12bdb72_b78f_4c51_a575_48fce3bcb220" name="P1_50_apCAF" value="1e-09" units="MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent Treg induction by apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw109fc087_3ad2_49dc_9db0_dce5691eb868" name="aPSC_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total activated PSC count (iCAF+myCAF+apCAF). Backward compatibility for test statistics.</body>
        </notes>
      </parameter>
      <parameter id="mwfb99f779_189e_4651_8b25_8da59a646ec8" name="k_TGFb_sec_myCAF" value="2e-10" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGF-β secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw4d3788aa_5eea_4ddf_b18c_670644a4c4ca" name="k_CXCL12_sec_cancer" value="5e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 secretion rate by tumor cells</body>
        </notes>
      </parameter>
      <parameter id="mw339a144c_d2f6_4b51_be04_205b64069d0d" name="k_CCL5_sec_iCAF" value="3e-11" units="MWDERIVEDUNIT_nanomole__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CCL5 secretion rate by iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw1216af70_7756_49c2_96cb_80847308f449" name="H_P1_apCAF" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for antigen-dependent apCAF Treg induction</body>
        </notes>
      </parameter>
      <parameter id="mw6b6f659b_306d_4349_8c9d_21bc8e34b930" name="k_GVAX_clearance" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GVAX cell clearance rate from tumor</body>
        </notes>
      </parameter>
      <parameter id="mw8251674b_84e6_4eba_b793_7bccf7a8a238" name="V_ID_volume" value="0.0001" units="MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of intradermal injection site (~0.1 mL)</body>
        </notes>
      </parameter>
      <parameter id="mw979adc09_f5a0_47b9_9c63_ee6997af977b" name="k_GMCSF_prod" value="1e-08" units="MWDERIVEDUNIT_nanomolarity__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF production rate per GVAX cell per day</body>
        </notes>
      </parameter>
      <parameter id="mw9c4eddf7_094f_4d6f_b51c_f8ad8c36df53" name="k_GMCSF_deg" value="5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF degradation/clearance rate (half-life ~3 hours)</body>
        </notes>
      </parameter>
      <parameter id="mwb8576bb3_314e_4e53_b2e0_fa37729164a5" name="k_APC_recruit_ID" value="100000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC recruitment rate to intradermal injection site</body>
        </notes>
      </parameter>
      <parameter id="mw045d42f9_8dd1_40a2_a04f_557dbe067c5c" name="EC50_GMCSF" value="0.00294005042817446" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for GM-CSF-mediated APC recruitment and maturation</body>
        </notes>
      </parameter>
      <parameter id="mw1b7c4985_0ebd_4e8e_a752_630167ea912e" name="k_APC_mature_ID" value="2.72805986290677" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC maturation rate at injection site</body>
        </notes>
      </parameter>
      <parameter id="mw63ae8620_e570_4c24_99c1_4919678ca8c3" name="k_APC_mig_ID_LN" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC migration rate from injection site to lymph nodes</body>
        </notes>
      </parameter>
      <parameter id="mw52aab910_b81d_4f06_a740_f6313b9809df" name="k_APC_death_ID" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC death rate at injection site</body>
        </notes>
      </parameter>
      <parameter id="mwd64a01a9_2451_4e19_8b99_8982d6de8440" name="sigma_P1_per_mAPC" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen consumed per APC maturation event at injection site</body>
        </notes>
      </parameter>
      <parameter id="mw187fbba8_7540_44ac_94b0_6606a7c2097a" name="EC50_P1_mature" value="0.1" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent APC maturation. Lowered from 10 nM to 0.1 nM on 2026-04-21 (Fix 3): with the 10 nM value, V_ID.P1_GVAX (~0.009 nM steady state) produced a Hill factor of ~0.0009 in J_mature_ID, so GVAX-derived antigen was never a meaningful contributor to APC maturation — maturation proceeded almost entirely via the GMCSF + baseline APC terms. 0.1 nM is an estimated value in the nanomolar-affinity range typical of peptide/antigen-receptor interactions; not anchored to a specific primary source. Candidate for submodel-target extraction.</body>
        </notes>
      </parameter>
      <parameter id="mwc54d045d_d4d5_4c7c_bda3_e56c136a9f0b" name="K_APC_ID" value="1000000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mw871fd419_3064_4298_9fac_445880f5c09a" name="k_APC_recruit0" value="100" units="MWDERIVEDUNIT_cell__day" constant="true"/>
      <parameter id="mwb595f448_b62d_44ee_9227_2ac3b8975b57" name="k_mAPC_death_ID" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mw5d90803b_244f_4a5b_b0c3_495179eab381" name="y_Ag_per_cell" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true"/>
      <parameter id="mwa7f627ca_a773_4d86_80aa_e5334536ed9d" name="k_P1_deg_ID" value="10" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mwaca08600_9e82_4fd7_a682_9e49379c075e" name="K_APC_mig" value="100000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mw9c4d0bf7_0cdc_4beb_96b9_e7e07e6444a4" name="k_cDC1_Ag_transfer" value="1e-07" units="MWDERIVEDUNIT_1__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen-transfer rate constant: migratory mcDC2 -&gt; resident cDC1 cross-licensing (Ferris 2022 PMID: 35648641; Mueller 2017 Eur J Immunol)</body>
        </notes>
      </parameter>
      <parameter id="mwffaee8f5_7a6b_44b5_92bd_9257a276c182" name="H_GMCSF_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mw8161d8ea_f351_4493_8745_0a6b75c4661d" name="J_mature_ID" value="0" units="MWDERIVEDUNIT_cell__day" constant="false"/>
      <parameter id="mwc11c2cd0_066f_4b2d_b712_474fb42f966a" name="k_Cy_clear" value="2.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide clearance rate</body>
        </notes>
      </parameter>
      <parameter id="mw5835c9c3_d076_4292_b11d_9c9338396852" name="k_Cy_Treg_deplete" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Maximum Treg depletion rate by cyclophosphamide</body>
        </notes>
      </parameter>
      <parameter id="mw566af5cc_b7f8_417e_a5e0_45328153e576" name="Cy_50_Treg" value="50" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_gram" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide concentration for 50% Treg depletion</body>
        </notes>
      </parameter>
      <parameter id="mwa59b1458_e7bb_49be_981b_4f946cc2e226" name="nucleated_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All nucleated cells in V_T (cancer + immune + CAFs). Used as the denominator for _pct_ calibration targets matching mIHC &quot;% of all nucleated cells&quot; measurements.</body>
        </notes>
      </parameter>
    </listOfParameters>
    <listOfInitialAssignments>
      <initialAssignment symbol="mwa2683694_e97c_4d9f_98dc_6734ecd4af74">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
