        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;myCAF activation rate (TGFb-driven)</body>
        </notes>
      </parameter>
      <parameter id="mwf31ec7e7_977a_46cf_98b8_9c87001e4ce1" name="k_PSC_to_iCAF" value="0.2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
